package dev.cajeta.cabra;

import cajeta.codec.json.JsonLinesWriter;
import cajeta.io.file.FileReader;
import cajeta.io.file.FileWriter;
import cajeta.io.file.Path;
import cajeta.lang.Integer;
import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.EngineOptions;
import dev.cajeta.llm.LlmEngine;
import dev.cajeta.llm.chat.ChatTemplate;
import dev.cajeta.logging.Level;
import dev.cajeta.logging.Log;
import dev.cajeta.logging.Logger;
import dev.cajeta.cabra.diag.DiagQueue;
import dev.cajeta.cabra.diag.DiagnosticBridge;
import dev.cajeta.cabra.io.LineReader;
import dev.cajeta.cabra.stdio.Serve;
import dev.cajeta.cabra.client.Relay;
import dev.cajeta.cabra.ws.Host;

/**
 * cabra — the resident-model serving harness (spec §1). A cabra is a
 * goat; a harness is what you put on one.
 *
 *   cabra serve --model <gguf> [--ctx N] [--max-seqs N] [--device be]
 *
 * Loads the model ONCE, then answers id-tagged JSONL requests on stdin
 * with id-tagged JSONL on stdout (spec §3.1.1/§3.1.2); every log line
 * goes to stderr, stdout is protocol-pure. Resident until killed
 * (spec §7.1); EOF on stdin or `{"op":"shutdown"}` drains and exits 0.
 */
public final class Main {

    // The bridge and its drainer, OWNED here for the life of the
    // process: `Diag.register` records a BORROW, so whatever it points
    // at must be held by someone for as long as diagnostics are on. The
    // Task static is what keeps the drainer fiber from being joined the
    // moment it is spawned.
    static DiagnosticBridge bridge;
    // §10.9: the forwarding queue between the bridge and the transport.
    static DiagQueue diagQueue;

    /**
     * Honor `--verbose`: consume the engine's diagnostic RECORDS (spec
     * §8.2, engine §11.8) through `DiagnosticBridge` — enqueue on the
     * engine's thread, render + log on cabra's own drainer fiber.
     *
     * Off by default, and off means the engine BUILDS nothing at all —
     * stdout is protocol-pure and stderr is not a dumping ground.
     */
    static void applyDiag(boolean verbose) {
        // Log.at, NOT Log.console: `console` builds its OWN
        // ConsoleAppender per call, so the engine's diagnostics would
        // run as a SECOND stream beside cabra's own logs and would
        // stop following the moment a file sink is configured. `at`
        // borrows the process's DI encoder+appender, so both
        // aggregate into one stream (Julian, 2026-08-30).
        //
        // The bridge now exists in every mode, because a client may ask
        // for its records (§10.9); what --verbose decides is whether
        // they are ALSO logged, and whether the engine is observed all
        // the time or only while some request asks (the transport
        // registers the bridge on demand otherwise, so the unobserved
        // engine builds nothing).
        Logger log #= Log.at("cabra.engine", Level.DEBUG);
        Main.bridge #= heap DiagnosticBridge(#log);
        Main.bridge.setLogging(verbose);
        Main.diagQueue = heap DiagQueue();
        Main.bridge.setQueue(Main.diagQueue);
        DiagnosticBridge.start(Main.bridge);
        if (verbose) {
            Diag.register(Main.bridge);
        }
        return;
    }

    public static int32 main(String[] args) {
        String verb = "";
        if ((int32) args.count() >= 1) {
            verb = args[0];
        }
        if (verb.equals("serve")) {
            return Main.serveMain(args);
        }
        if (verb.equals("host")) {
            return Main.hostMain(args);
        }
        Main.usage();
        return 2;
    }

    static #LlmEngine loadEngine(String model, int32 ctx,
            int32 maxSeqs, String device, String kvStore) {
        EngineOptions opts = heap EngineOptions(model);
        opts.ctx = ctx;
        opts.maxSeqs = maxSeqs;
        if (!device.equals("")) {
            opts.device = device;
        }
        if (!kvStore.equals("")) {
            opts.kvStore = kvStore;
        }
        return #LlmEngine.load(#opts);
    }

    /** `serve` — embedded engine on stdio, or (with `--connect`) the
     *  same stdio protocol relayed to a running host (unit 8). */
    static int32 serveMain(String[] args) {
        String model = "";
        int32 ctx = 512;
        int32 maxSeqs = 1;
        String device = "";
        boolean verbose = false;
        String connect = "";
        String token = "";
        int64 session = 0L - 1L;
        int32 i = 1;
        while (i < (int32) args.count()) {
            String a = args[i];
            if (a.equals("--model") && i + 1 < (int32) args.count()) {
                i = i + 1;
                model = args[i];
            } else if (a.equals("--ctx") && i + 1 < (int32) args.count()) {
                i = i + 1;
                ctx = Integer.parseInt(args[i]);
            } else if (a.equals("--max-seqs")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                maxSeqs = Integer.parseInt(args[i]);
            } else if (a.equals("--device")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                device = args[i];
            } else if (a.equals("--connect")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                connect = args[i];
            } else if (a.equals("--token")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                token = args[i];
            } else if (a.equals("--session")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                session = (int64) Integer.parseInt(args[i]);
            } else if (a.equals("--verbose")) {
                // A BARE toggle — unlike every flag above it, this one
                // takes no value, so it must not advance `i`.
                verbose = true;
            } else {
                System.stderr.println("cabra: unknown argument " + a);
                Main.usage();
                return 2;
            }
            i = i + 1;
        }

        if (!connect.equals("")) {
            // 8.1.3: --connect drives a RUNNING host, and only that —
            // a model flag here would smell like "start one for me".
            if (!model.equals("")) {
                System.stderr.println("cabra: --connect uses a running"
                    + " host; drop --model (cabra never starts a host"
                    + " implicitly)");
                return 2;
            }
            int32 p = Main.portOf(connect);
            if (p <= 0) {
                System.stderr.println("cabra: bad --connect target '"
                    + connect + "' (use PORT or 127.0.0.1:PORT)");
                return 2;
            }
            Main.applyDiag(verbose);
            FileWriter fw #= heap FileWriter(1);
            Relay rel = heap Relay(p, token, session, #fw);
            FileReader stdin0 #= heap FileReader(0);
            LineReader r = heap LineReader(#stdin0);
            LineReader.start(r);
            int32 rc = rel.run(r);
            r.close();
            rel.shut();
            if (Main.bridge != null) {
                Main.bridge.flush();
                Main.bridge.close();
            }
            return rc;
        }

        if (model.equals("")) {
            Main.usage();
            return 2;
        }

        Main.applyDiag(verbose);
        System.stderr.println("cabra: loading " + model);
        LlmEngine e #= Main.loadEngine(model, ctx, maxSeqs, device, "");
        FileWriter fw #= heap FileWriter(1);
        // The template comes from the model's own metadata, and stays
        // null when it ships none — `chat` then refuses rather than
        // guessing one (plan 3.2.1).
        ChatTemplate tpl #= ChatOp.forModel(model, e.tokenizer());
        Serve s = heap Serve(#e, #fw, model, ctx);
        s.setCapacity(maxSeqs);
        s.setDiag(Main.diagQueue, Main.bridge, verbose);
        if (tpl != null) {
            s.setTemplate(#tpl);
        } else {
            System.stderr.println("cabra: model ships no chat template - "
                + "the \"chat\" op will refuse; use \"generate\"");
        }
        System.stderr.println("cabra: ready (jsonl on stdin; "
            + "{\"op\":\"shutdown\"} or EOF exits)");

        // 4.2.1: the reader FIBER owns stdin (awaitReadable poll-and-
        // park), the serve loop owns every engine call, and lines are
        // admitted mid-generation — requests genuinely overlap now.
        FileReader stdin0 #= heap FileReader(0);
        LineReader r = heap LineReader(#stdin0);
        LineReader.start(r);
        s.runLoop(r);
        r.close();
        // Let the drainer publish what generation enqueued, then stop
        // it, so the static Task's exit-time join terminates.
        if (Main.bridge != null) {
            Main.bridge.flush();
            Main.bridge.close();
        }
        System.stderr.println("cabra: shutdown");
        return 0;
    }

    /** `host` — one loaded model serving N ws clients on loopback
     *  (spec §5.1.2, plan unit 7). */
    static int32 hostMain(String[] args) {
        String model = "";
        int32 ctx = 512;
        int32 maxSeqs = 4;
        int32 maxConns = 16;
        int32 port = 8850;
        String token = "";
        String device = "";
        String kvStore = "";
        String web = "";
        int64 idleExpiryMs = 600000L;
        boolean verbose = false;
        int32 i = 1;
        while (i < (int32) args.count()) {
            String a = args[i];
            if (a.equals("--model") && i + 1 < (int32) args.count()) {
                i = i + 1;
                model = args[i];
            } else if (a.equals("--ctx") && i + 1 < (int32) args.count()) {
                i = i + 1;
                ctx = Integer.parseInt(args[i]);
            } else if (a.equals("--max-seqs")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                maxSeqs = Integer.parseInt(args[i]);
            } else if (a.equals("--max-conns")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                maxConns = Integer.parseInt(args[i]);
            } else if (a.equals("--port")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                port = Integer.parseInt(args[i]);
            } else if (a.equals("--token")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                token = args[i];
            } else if (a.equals("--idle-expiry")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                idleExpiryMs = (int64) Integer.parseInt(args[i]);
            } else if (a.equals("--kv-store")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                kvStore = args[i];
            } else if (a.equals("--web")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                web = args[i];
            } else if (a.equals("--device")
                    && i + 1 < (int32) args.count()) {
                i = i + 1;
                device = args[i];
            } else if (a.equals("--verbose")) {
                verbose = true;
            } else {
                System.stderr.println("cabra: unknown argument " + a);
                Main.usage();
                return 2;
            }
            i = i + 1;
        }
        if (model.equals("")) {
            Main.usage();
            return 2;
        }
        if (!web.equals("")) {
            // §10.1: a root that is not a directory is a misconfiguration
            // to refuse at start, not a 404 on every page.
            Path wp #= Path.of(web);
            if (!wp.isDir()) {
                System.stderr.println("cabra: --web " + web
                    + " is not a directory");
                return 2;
            }
        }
        if (token.equals("")) {
            System.stderr.println("cabra: WARNING - host without "
                + "--token accepts any loopback connector");
        }
        Main.applyDiag(verbose);
        System.stderr.println("cabra: loading " + model);
        LlmEngine e #= Main.loadEngine(model, ctx, maxSeqs, device,
            kvStore);
        ChatTemplate tpl #= ChatOp.forModel(model, e.tokenizer());
        Host h = heap Host(#e, token, maxConns, maxSeqs, idleExpiryMs);
        h.setContext(ctx);
        h.setDiag(Main.diagQueue, Main.bridge, verbose);
        if (!web.equals("")) {
            h.setWebRoot(web);
        }
        if (tpl != null) {
            h.setTemplate(#tpl);
        } else {
            System.stderr.println("cabra: model ships no chat template"
                + " - the \"chat\" op will refuse; use \"generate\"");
        }
        h.listen(port);
        System.stderr.println("cabra: host on 127.0.0.1:" + h.port
            + " (sessions " + maxSeqs + ", conns " + maxConns + ")");
        if (!web.equals("")) {
            System.stderr.println("cabra: web client at http://127.0.0.1:"
                + h.port + "/ from " + web);
        }
        h.run();
        h.shutdown();
        if (Main.bridge != null) {
            Main.bridge.flush();
            Main.bridge.close();
        }
        System.stderr.println("cabra: shutdown");
        return 0;
    }

    /** `PORT` or `HOST:PORT` -> the port; -1 when unparseable. Only
     *  loopback is served or dialed (§5.5.2), so the host part is
     *  never resolved. */
    static int32 portOf(String target) {
        int8[] b #= target.toBytes();
        int32 n = (int32) b.count();
        int32 ci = 0 - 1;
        int32 i = 0;
        while (i < n) {
            if (b[i] == (int8) 58) {
                ci = i;
            }
            i = i + 1;
        }
        int32 at = ci + 1;
        if (at >= n) {
            return 0 - 1;
        }
        int32 v = 0;
        i = at;
        while (i < n) {
            if (b[i] < (int8) 48 || b[i] > (int8) 57) {
                return 0 - 1;
            }
            v = v * 10 + (int32) (b[i] - (int8) 48);
            i = i + 1;
        }
        return v;
    }

    static void usage() {
        System.stderr.println("usage: cabra serve --model <path> "
            + "[--ctx N] [--max-seqs N] [--device <backend>] "
            + "[--verbose]");
        System.stderr.println("       cabra serve --connect "
            + "[127.0.0.1:]PORT [--token T] [--session N] [--verbose]");
        System.stderr.println("       cabra host --model <path> "
            + "[--port N] [--token T] [--ctx N] [--max-seqs N] "
            + "[--max-conns N] [--idle-expiry MS] [--kv-store DIR] "
            + "[--web DIR] [--device <backend>] [--verbose]");
        System.stderr.println("  serve: JSONL on stdin -> JSONL on "
            + "stdout; logs on stderr; EOF or {\"op\":\"shutdown\"} "
            + "exits");
        System.stderr.println("  --connect drives ONE conversation on "
            + "a running host (never starts one); --session resumes");
        System.stderr.println("  host: serves ws clients on loopback; "
            + "--kv-store makes reconnects warm across sessions; "
            + "--web serves the browser client from DIR on the same port");
        System.stderr.println("  --verbose  engine diagnostics to the "
            + "log at DEBUG");
        return;
    }

}
