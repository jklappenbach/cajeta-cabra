package dev.cajeta.cabra;

import cajeta.codec.json.JsonLinesWriter;
import cajeta.collection.ArrayList;
import cajeta.io.file.FileWriter;
import cajeta.lang.Optional;
import cajeta.lang.String;
import cajeta.time.Clock;
import dev.cajeta.llm.LlmEngine;
import dev.cajeta.llm.chat.ChatTemplate;
import dev.cajeta.llm.gen.SampleParams;
import dev.cajeta.llm.gen.TokenSink;
import dev.cajeta.llm.sched.Request;

/**
 * The serve loop (plan 2.2.3, extended by 3.2 and 4.2): requests are
 * SUBMITTED as their lines arrive and DRIVEN together, so several can be
 * in flight at once and the scheduler's continuous batching gets its
 * first real multi-client caller.
 *
 * `handleLine` submits and returns; `drive()` steps the scheduler until
 * every tracked request is done, emitting each done line the moment that
 * request finishes rather than in submission order. Splitting the two is
 * what makes batching expressible at all — a handleLine that drove to
 * completion could only ever run one request at a time.
 *
 * Implements the engine's `TokenSink`, and the sink is where multiplexing
 * actually bites: `onToken` arrives with the SCHEDULER's request id, which
 * is not the caller's. Every chunk is routed through the rid -> caller-id
 * table below, so two interleaved requests cannot cross-talk. EOG ids are
 * filtered through `engine.isEog` (spec §4.2), so a stop token never
 * reaches the wire.
 *
 * Timing is measured HERE, per request: prefill_ms is submit-to-first-
 * token, decode_ms first-token-to-done — the split every serving stack
 * reports, needing no engine hooks. Under batching these overlap between
 * requests, which is the point.
 */
public final class Serve implements TokenSink {

    LlmEngine engine;          // owned
    // BOTH owned, and that is load-bearing: JsonLinesWriter stores its
    // sink with `#=` from a PLAIN parameter, so it records a BORROW
    // (ownership §1: a call argument lends unless the caller writes #).
    // A caller that let its FileWriter local drop while handing us the
    // writer left the sink dangling — every emit went nowhere and the
    // heap corrupted on the way out. Serve outlives both, so it holds
    // both.
    FileWriter sink;           // owned
    JsonLinesWriter out;       // owned; borrows `sink`
    ChatTemplate tpl;          // owned; null when the model ships none
    String modelPath;
    String state;              // health: "loading" | "ready"
    int32 ctx;                 // context window, in tokens

    // ── in-flight table, indexed by slot ───────────────────────────────
    // Parallel arrays rather than a map: the bound is maxSeqs-ish, a
    // linear scan beats hashing at this size, and the sink's lookup is on
    // the per-token path.
    int32 cap;
    int32 live;
    int32[] trRid;             // scheduler request id
    int64[] trId;              // caller's correlation id
    int32[] trPromptLen;
    int64[] trT0Ns;
    int64[] trFirstNs;
    boolean[] trOpen;          // slot holds an unfinished request

    public Serve(#LlmEngine engine, #FileWriter sink,
            String modelPath, int32 ctx) {
        this.engine #= engine;
        this.sink #= sink;
        this.out = heap JsonLinesWriter(this.sink);
        this.tpl = null;
        this.modelPath = modelPath;
        this.state = "ready";
        this.ctx = ctx;
        this.cap = 32;
        this.live = 0;
        this.trRid = heap int32[this.cap];
        this.trId = heap int64[this.cap];
        this.trPromptLen = heap int32[this.cap];
        this.trT0Ns = heap int64[this.cap];
        this.trFirstNs = heap int64[this.cap];
        this.trOpen = heap boolean[this.cap];
        this.engine.setSink(this);
    }

    public LlmEngine engineRef() {
        return this.engine;
    }

    /** Install the model's chat template. Left unset (null) the `chat`
     *  op refuses — cabra never guesses a template (plan 3.2.1). */
    public void setTemplate(#ChatTemplate t) {
        this.tpl #= t;
        return;
    }

    /** Health state the `health` op reports. Main flips this to "ready"
     *  once the engine is up. */
    public void setState(String s) {
        this.state = s;
        return;
    }

    /** How many requests are currently in flight. */
    public int32 inFlight() {
        return this.live;
    }

    /** Bound on concurrent in-flight requests (plan 4.1.2). Main sets it
     *  from `--max-seqs`; past it, submissions get a busy answer rather
     *  than a hang. Only valid before anything is in flight. */
    public void setCapacity(int32 n) {
        if (n < 1 || this.live > 0) {
            return;
        }
        this.cap = n;
        this.trRid = heap int32[n];
        this.trId = heap int64[n];
        this.trPromptLen = heap int32[n];
        this.trT0Ns = heap int64[n];
        this.trFirstNs = heap int64[n];
        this.trOpen = heap boolean[n];
        return;
    }

    /** Drain and release the sink. Every emit already flushes, so this
     *  is the last-line guarantee for a reader that opens the transcript
     *  after us. */
    public void close() {
        this.out.flush();
        this.sink.close();
        return;
    }

    /** One protocol line. Returns false when the loop should end. */
    public boolean handleLine(String line) {
        Req r #= Protocol.parseLine(line);
        if (!r.ok) {
            Protocol.emitError(this.out, r.id, r.hasId, r.err);
            return true;
        }
        if (r.op.equals("shutdown")) {
            return false;
        }
        if (r.op.equals("health")) {
            Protocol.emitHealth(this.out, r.id, this.state,
                this.modelPath);
            return true;
        }
        if (!r.hasId) {
            // Streaming without a correlation key is unanswerable.
            Protocol.emitError(this.out, 0L, false,
                r.op + " needs an id");
            return true;
        }

        if (r.op.equals("chat")) {
            String rendered #= ChatOp.render(this.tpl, r.messagesRaw);
            if (rendered == null) {
                Protocol.emitError(this.out, r.id, true,
                    "this model ships no chat template - use \"generate\" "
                    + "with a raw prompt");
                return true;
            }
            // RAW encode: the render already carries BOS and the role
            // headers, so encodePrompt would prepend a second BOS.
            int32[] ids #= this.engine.tokenizer().encode(rendered);
            this.submitOne(r, #ids);
            return true;
        }

        int32[] ids #= this.engine.tokenizer().encodePrompt(r.prompt);
        this.submitOne(r, #ids);
        return true;
    }

    /** Submit one request and start tracking it. Emits an error object
     *  (and tracks nothing) when it cannot be admitted. */
    void submitOne(Req r, #int32[] ids) {
        int32 n = (int32) ids.count();
        // A prompt that cannot fit the window is never ADMITTED, and an
        // unadmitted request leaves the scheduler permanently not-done:
        // it spins to the step cap and throws. Caught here as a plain
        // answer, because "your prompt is longer than the context" is a
        // request error, not a server fault — and the third turn of a
        // chat is exactly where it shows up.
        if (n + r.n > this.ctx) {
            Protocol.emitError(this.out, r.id, true,
                "prompt is " + n + " tokens and -n is " + r.n
                + ", which exceeds the " + this.ctx + "-token context");
            return;
        }
        int32 slot = this.freeSlot();
        if (slot < 0) {
            // Backpressure (plan 4.1.2): an explicit busy answer, never a
            // hang and never a silently dropped line.
            Protocol.emitError(this.out, r.id, true,
                "server busy: " + this.live + " requests in flight");
            return;
        }

        SampleParams p = heap SampleParams(r.temp, r.seed);
        p.topK = r.topK;
        p.topP = r.topP;
        p.repeatPenalty = r.repeatPenalty;
        // stopTokens stays null: the engine fills the model's EOG set.
        // `stops` goes to the ENGINE rather than being trimmed after the
        // fact — it checks them against a rolling detokenized tail, so a
        // halt suppresses the text before it streams, where a post-hoc
        // trim would already have sent it (plan 3.2.2).
        //
        // OWNED COPIES, not `p.stops #= r.stops`: that records a BORROW
        // of the Req (ownership §2.3), but `#p` hands SampleParams to the
        // engine, which keeps it on the Request past this call — while
        // the Req drops at the end of it. The lend would dangle.
        if (r.stops != null) {
            ArrayList<String> sc = heap ArrayList<String>();
            int32 si = 0;
            while (si < r.stops.count()) {
                String s0 = r.stops.get(si);
                int8[] sb #= s0.toBytes();
                String cp = heap String(#sb, s0.byteLength());
                sc.add(#cp);
                si = si + 1;
            }
            p.stops #= sc;
        }

        int32 rid = 0;
        try {
            rid = this.engine.submitTokens(ids, n, r.n, #p);
        } catch (Throwable t) {
            // Liveness (spec §3.2): a failed request is answered, never
            // fatal. Unit 2 pinned this for malformed lines; an engine
            // fault has to obey the same rule or one bad prompt takes the
            // resident model down with it.
            Protocol.emitError(this.out, r.id, true,
                "submit failed: " + t.getMessage());
            return;
        }
        this.ensureChunker();
        this.chunker.reset(slot);
        this.trRid[slot] = rid;
        this.trId[slot] = r.id;
        this.trPromptLen[slot] = n;
        this.trT0Ns[slot] = Clock.nanoTime();
        this.trFirstNs[slot] = 0L;
        this.trOpen[slot] = true;
        this.live = this.live + 1;
        return;
    }

    /**
     * Step the scheduler until every tracked request is done, emitting
     * each done line as that request finishes. Returns the number of
     * requests completed.
     *
     * The bound is derived from what the in-flight set can actually need
     * — the longest budget plus its prompt plus admission slack — rather
     * than a context-derived guess that is both too small for a long
     * prompt and unbounded slack for a short one.
     */
    public int32 drive() {
        int32 completed = 0;
        if (this.live == 0) {
            return 0;
        }
        int32 bound = this.driveBound();
        int32 steps = 0;
        while (this.live > 0) {
            boolean more = false;
            try {
                more = this.engine.stepOnce();
            } catch (Throwable t) {
                this.failAllOpen("generation failed: " + t.getMessage());
                return completed;
            }
            completed = completed + this.reapFinished();
            if (!more) {
                break;
            }
            steps = steps + 1;
            if (steps > bound) {
                this.failAllOpen("scheduler made no progress within "
                    + bound + " steps");
                return completed;
            }
        }
        // A final reap: the step that returned "no more" is the one that
        // finished the last request.
        completed = completed + this.reapFinished();
        return completed;
    }

    /**
     * ONE scheduler step plus a reap — the reader-loop quantum (4.2.1).
     * `drive()` runs to completion and cannot notice a line that
     * arrives mid-generation; the serve loop interleaves THIS with the
     * reader's channel instead. Stall protection carries over:
     * consecutive stepped-without-completing quanta beyond the drive
     * bound fail the in-flight set the same way drive() would.
     */
    public int32 driveStep() {
        if (this.live == 0) {
            this.idleSteps = 0;
            return 0;
        }
        int32 completed = 0;
        try {
            this.engine.stepOnce();
        } catch (Throwable t) {
            this.failAllOpen("generation failed: " + t.getMessage());
            return completed;
        }
        completed = this.reapFinished();
        if (completed > 0) {
            this.idleSteps = 0;
        } else {
            this.idleSteps = this.idleSteps + 1;
            if (this.idleSteps > this.driveBound()) {
                this.failAllOpen("scheduler made no progress within "
                    + this.idleSteps + " steps");
                this.idleSteps = 0;
            }
        }
        return completed;
    }

    int32 idleSteps;

    /**
     * The reader-fed serve loop (4.2.1): lines are admitted the moment
     * they arrive — including MID-generation, which is what the
     * reader fiber exists for — and every engine call stays on THIS
     * thread. Returns total completed requests. Ends at EOF (channel
     * closed and drained) or when an op asks to stop, after finishing
     * whatever is in flight.
     */
    public int32 runLoop(LineReader r) {
        int32 completed = 0;
        boolean ending = false;
        while (true) {
            if (this.live > 0) {
                completed = completed + this.driveStep();
                // Absorb everything that arrived during the step.
                boolean absorbing = !ending;
                while (absorbing) {
                    Optional<int32> got = r.ch.tryReceive();
                    if (got.isPresent()) {
                        String line = r.lineAt(got.get());
                        if (line.byteLength() > 0
                                && !this.handleLine(line)) {
                            ending = true;
                            absorbing = false;
                        }
                    } else {
                        absorbing = false;
                        if (r.drained()) {
                            ending = true;
                        }
                    }
                }
            } else if (ending) {
                return completed;
            } else {
                // Idle: park until the next line or EOF.
                Optional<int32> got = r.ch.receive();
                if (got.isEmpty()) {
                    return completed;
                }
                String line = r.lineAt(got.get());
                if (line.byteLength() > 0 && !this.handleLine(line)) {
                    ending = true;
                }
            }
        }
    }

    int32 driveBound() {
        int32 worst = 0;
        int32 i = 0;
        while (i < this.cap) {
            if (this.trOpen[i]) {
                int32 need = this.trPromptLen[i] + this.ctx;
                if (need > worst) {
                    worst = need;
                }
            }
            i = i + 1;
        }
        return worst + 64;
    }

    /** Emit done lines for every tracked request that has finished. */
    int32 reapFinished() {
        int32 done = 0;
        int32 i = 0;
        while (i < this.cap) {
            if (this.trOpen[i]) {
                Request q = this.engine.request(this.trRid[i]);
                if (q.finishReason() != Request.FINISH_NONE) {
                    this.emitDoneFor(i, q);
                    done = done + 1;
                }
            }
            i = i + 1;
        }
        return done;
    }

    void emitDoneFor(int32 slot, Request q) {
        this.ensureChunker();
        if (this.chunker.hasTail(slot)) {
            String tailS #= this.chunker.take(slot,
                Host.emptyBytes(), true);
            if (tailS.byteLength() > 0) {
                Protocol.emitChunk(this.out, this.trId[slot], tailS);
            }
        }
        String finish = "budget";
        if (q.finishReason() == Request.FINISH_EOS) {
            finish = "eos";
        }
        if (q.finishReason() == Request.FINISH_STOP) {
            finish = "stop";
        }
        int64 endNs = Clock.nanoTime();
        int64 pMs = 0L;
        int64 dMs = 0L;
        if (this.trFirstNs[slot] > 0L) {
            pMs = (this.trFirstNs[slot] - this.trT0Ns[slot]) / 1000000L;
            dMs = (endNs - this.trFirstNs[slot]) / 1000000L;
        } else {
            pMs = (endNs - this.trT0Ns[slot]) / 1000000L;
        }
        Protocol.emitDone(this.out, this.trId[slot], finish,
            (int64) this.trPromptLen[slot], (int64) q.generatedCount(),
            pMs, dMs);
        this.trOpen[slot] = false;
        this.live = this.live - 1;
        return;
    }

    /** Answer every open request with an error and stop tracking them —
     *  an engine fault must not leave a caller waiting forever. */
    void failAllOpen(String message) {
        int32 i = 0;
        while (i < this.cap) {
            if (this.trOpen[i]) {
                Protocol.emitError(this.out, this.trId[i], true, message);
                this.trOpen[i] = false;
                this.live = this.live - 1;
            }
            i = i + 1;
        }
        return;
    }

    int32 freeSlot() {
        int32 i = 0;
        while (i < this.cap) {
            if (!this.trOpen[i]) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    int32 slotOfRid(int32 rid) {
        int32 i = 0;
        while (i < this.cap) {
            if (this.trOpen[i] && this.trRid[i] == rid) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    public void onToken(int32 reqId, int32 token) {
        if (this.engine.isEog(token)) {
            return;
        }
        // The demux (plan 4.2.2): reqId is the SCHEDULER's id. Routing by
        // a single "current request" would send every interleaved token
        // to whichever caller submitted last.
        int32 slot = this.slotOfRid(reqId);
        if (slot < 0) {
            return;
        }
        if (this.trFirstNs[slot] == 0L) {
            this.trFirstNs[slot] = Clock.nanoTime();
        }
        int32[] one #= heap int32[1];
        one[0] = token;
        int8[] b #= this.engine.tokenizer().decode(one, 1);
        // Same hold-back as the ws host (Utf8Chunker): the TRANSCRIPT
        // must not depend on which transport carried it, and a token
        // boundary is allowed to split a multi-byte sequence.
        this.ensureChunker();
        String s #= this.chunker.take(slot, b, false);
        if (s.byteLength() > 0) {
            Protocol.emitChunk(this.out, this.trId[slot], s);
        }
        return;
    }

    Utf8Chunker chunker;

    void ensureChunker() {
        if (this.chunker == null) {
            this.chunker = heap Utf8Chunker(this.cap);
        }
        return;
    }
}
