package dev.cajeta.cabra.core;

import cajeta.lang.String;
import dev.cajeta.primavera.context.SessionStore;

/**
 * What the session store's eviction observer saw (plan 12.1.6): sessions
 * that left, by reason. The store logs each one itself (spec §8.6). The
 * observer is a static call over this tally rather than a lambda over
 * `Sessions`, so the store holds no borrow of its owner.
 */
public final class EvictionTally {

    public int32 closed;
    public int32 expired;

    public EvictionTally() {
        this.closed = 0;
        this.expired = 0;
        return;
    }

    public static void note(EvictionTally t, String id, int32 reason) {
        if (reason == SessionStore.CLOSED) {
            t.closed = t.closed + 1;
        } else if (reason == SessionStore.EXPIRED) {
            t.expired = t.expired + 1;
        }
        return;
    }
}
