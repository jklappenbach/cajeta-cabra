package dev.cajeta.cabra;

import cajeta.lang.String;
import dev.cajeta.llm.DiagSink;
import dev.cajeta.logging.Logger;

/**
 * Bridges the engine's `DiagSink` seam onto `dev.cajeta.logging`.
 *
 * The engine declares the seam and depends on no logging backend — a
 * library must not choose one for its embedder (see `dev.cajeta.llm.Diag`).
 * cabra IS the embedder, so it makes the choice here.
 *
 * The lines land at DEBUG, deliberately. They say which route a projection
 * took — tuning detail for whoever is measuring the engine, not news for
 * whoever is operating the server. At INFO they would appear in every
 * default-configured log and recreate the console noise the `Diag` hook
 * was introduced to stop (Julian, 2026-08-27).
 */
public final class LoggingDiagSink implements DiagSink {

    // OWNED: `Log.capturing`/`Log.console` hand back a `#Logger`, and the
    // sink outlives the call that built it. A plain `=` here would record
    // a borrow of a logger nobody else holds.
    Logger log;

    public LoggingDiagSink(#Logger l) {
        this.log #= l;
        return;
    }

    public void line(String message) {
        this.log.debug(message);
        return;
    }
}
