package dev.cajeta.cabra.ws;

import cajeta.concurrent.Fiber;
import cajeta.time.Duration;
import cajeta.collection.ArrayList;
import cajeta.concurrent.Lock;
import cajeta.concurrent.LockGuard;
import cajeta.concurrent.Semaphore;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.ByteBuffer;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.TcpStream;
import cajeta.lang.String;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.HeadScanner;
import dev.cajeta.http.Method;
import dev.cajeta.http.Version;
import dev.cajeta.http.h1.HttpParserLimits;
import dev.cajeta.http.middleware.Middleware;
import dev.cajeta.http.middleware.MiddlewareChain;
import dev.cajeta.http.middleware.StaticFile;
import dev.cajeta.http.ws.WebSocket;
import dev.cajeta.http.ws.WsMessage;
import dev.cajeta.http.ws.WsServerHandshake;
import dev.cajeta.cabra.io.LineReader;
import dev.cajeta.cabra.proto.Protocol;
import dev.cajeta.cabra.proto.Req;

/**
 * One host-mode connection (plan 7.2.2): owns the socket, its buffered
 * halves, the upgraded `WebSocket`, and the OUTBOUND ring its writer
 * fiber drains — because `ws.send` blocks when the peer's TCP window
 * is full, and a client that stops reading must never stall the host
 * loop or another session (spec §5.3.2, 7.1.6). The host enqueues;
 * this connection's writer fiber pays the peer's slowness; past the
 * ring bound the connection is SHED (marked dead), not waited on.
 *
 * The reader fiber parses each inbound message in place, from the
 * WebSocket's lent buffer, and hands the host an owned request: the
 * message is never copied, and the buffer is free for the next frame as
 * soon as the parse returns.
 */
public final class WsConn {

    static final int32 OUT_CAP = 256;
    static final int32 OUT_BYTES = 65536;

    public int32 slot;          // index in the host's table
    public boolean authed;
    public boolean dead;

    TcpStream sock;             // owned
    AsyncReader rd;             // owned; borrowed by ws
    AsyncWriter wr;             // owned; borrowed by ws
    WebSocket ws;               // owned

    // Outbound ring (host loop writes, writer fiber drains).
    Lock outMu;
    Semaphore outReady;
    ArrayList<String> outSlots;
    int32 outHead;
    int32 outTail;
    int32 outQueued;
    boolean outStop;
    boolean outStopped;

    Task<int32> readTask;
    Task<int32> writeTask;
    boolean readerDone;

    public WsConn(int32 slot, #TcpStream sock) {
        this.slot = slot;
        this.authed = false;
        this.dead = false;
        this.sock #= sock;
        this.rd = heap AsyncReader(this.sock);
        this.wr = heap AsyncWriter(this.sock);
        this.ws = null;
        this.outMu = heap Lock();
        this.outReady = heap Semaphore(0);
        this.outSlots = heap ArrayList<String>();
        int32 i = 0;
        while (i < WsConn.OUT_CAP) {
            String e2 #= WsConn.cp("");
            this.outSlots.add(#e2);
            i = i + 1;
        }
        this.outHead = 0;
        this.outTail = 0;
        this.outQueued = 0;
        this.outStop = false;
        this.outStopped = false;
        this.readerDone = false;
        return;
    }

    static #String cp(String s) {
        int8[] b #= s.toBytes();
        String c = heap String(#b, s.byteLength());
        return #= c;
    }

    /** Host loop: enqueue one outbound message. False = the ring is
     *  full (a non-reading client) — the caller sheds the connection
     *  rather than waiting (§5.3.2). A sink: the slot takes what was
     *  handed over, so a transferred message is never copied. */
    public boolean enqueueOut(String m) {
        {
            LockGuard g #= this.outMu.acquire();
            if (this.outQueued >= WsConn.OUT_CAP) {
                return false;
            }
            this.outSlots.set(this.outHead, #m);
            this.outHead = (this.outHead + 1) % WsConn.OUT_CAP;
            this.outQueued = this.outQueued + 1;
        }
        this.outReady.release();
        return true;
    }

    /** Send `m` from its own bytes: a server frame without compression
     *  goes straight to the socket writer. A string with no backing array
     *  of its own (a literal) is sent through the copying form. */
    static void sendInPlace(WebSocket ws, String m) {
        int8[] root = m.root();
        if (root == null) {
            ws.send(m);
            return;
        }
        ws.sendText(root, (int32) m.byteOffset(), m.byteLength());
        return;
    }

    /** The writer fiber: drain the ring into `ws.send`, absorbing the
     *  peer's read pace so nobody else has to. It sends straight from the
     *  tail slot and frees that slot only after the send returns: the host
     *  writes only at the head while the count is below the bound, so the
     *  slot being sent is never overwritten under it, and nothing copies
     *  the message out. */
    public static async int32 writeLoop(WsConn c) {
        while (true) {
            c.outReady.acquire();
            String m = null;
            boolean have = false;
            {
                LockGuard g #= c.outMu.acquire();
                if (c.outQueued > 0) {
                    m = c.outSlots.get(c.outTail);
                    have = true;
                }
            }
            if (have) {
                try {
                    WsConn.sendInPlace(c.ws, m);
                } catch (Exception e) {
                    c.dead = true;
                }
                {
                    LockGuard g3 #= c.outMu.acquire();
                    c.outTail = (c.outTail + 1) % WsConn.OUT_CAP;
                    c.outQueued = c.outQueued - 1;
                }
            } else if (c.outStop) {
                {
                    LockGuard g2 #= c.outMu.acquire();
                    c.outStopped = true;
                }
                return 0;
            }
        }
    }

    /** Spawn this connection's reader (which, once upgraded, spawns
     *  the writer). Lives HERE because `spawn` accepts only an
     *  unqualified same-class static (ASYNC_R3A), and the two-step
     *  binding is the one that neither double-frees nor join-blocks. */
    public static void startRead(WsConn c, Host h) {
        Task<int32> t = spawn readLoop(c, h);
        c.readTask #= t;
        return;
    }

    /** The reader fiber: upgrade, then feed inbound text messages into
     *  the shared host channel as (connSlot) signals via the host's
     *  ring protocol. `hostCh` is a lending channel of conn slots; the
     *  LINE lives in this connection's inbound ring. */
    public static async int32 readLoop(WsConn c, Host h) {
        // §10.1: an HTTP/1.1 front on the same socket. Plain requests
        // are answered from the web root on a keep-alive loop (a page
        // then its assets, one connection — what a browser does);
        // the first request carrying an Upgrade is the WebSocket, on
        // any path. No web root: 404 and close, so only the socket
        // protocol is reachable, as before this front existed.
        try {
            WsConn.front(c, h);
        } catch (Exception e) {
            c.dead = true;
            h.connGone(c.slot);
            c.readerDone = true;
            return 0;
        }
        Task<int32> wt = spawn writeLoop(c);
        c.writeTask #= wt;
        while (!c.dead) {
            // Lent, not received: the connection reuses one message, so
            // nothing is copied, and it stays valid until the next call.
            WsMessage m = null;
            try {
                m = c.ws.next();
            } catch (Exception e) {
                // A dead peer is normal lifecycle, but it must never be
                // SILENT — the 2026-08-31 wedge hid behind exactly this
                // catch. stderr is the fault channel; a torn transport
                // is a fault-shaped fact.
                System.stderr.println("cabra: conn " + c.slot
                    + " receive ended: " + e.getMessage());
                break;
            }
            if (m == null) {
                break;
            }
            if (!m.isText()) {
                continue;
            }
            Req r #= Protocol.parseBytes(m.bytes(), m.length());
            // Backpressure parks THIS fiber if the host loop lags.
            h.inbound(c.slot, #r);
        }
        c.dead = true;
        h.connGone(c.slot);
        c.readerDone = true;
        return 0;
    }

    /** Serves HTTP/1.1 requests from the web root until one upgrades, then
     *  leaves the WebSocket on `c` (§10.1). Throws when the peer closes or a
     *  plain request ends the connection. */
    static void front(WsConn c, Host h) {
        HttpParserLimits limits = heap HttpParserLimits();
        ByteBuffer out = heap ByteBuffer(WsConn.OUT_BYTES);
        String dir = h.webDir();
        (HttpRequest, HttpResponse) -> void miss =
            (HttpRequest q, HttpResponse r) -> WsConn.notFound(r);
        MiddlewareChain chain = heap MiddlewareChain();
        if (dir != null) {
            StaticFile cfg #= StaticFile.create(dir);
            Middleware m #= StaticFile.middleware(#cfg);
            chain.use(#m);
        }
        chain.build(miss);
        while (true) {
            ByteBuffer head #= HeadScanner.readHead(c.rd, limits);
            HttpRequest q = heap HttpRequest(limits.maxHeaderCount);
            HeadScanner.parseRequest(head.array(), 0, head.readable(), q);
            out.clear();
            HttpResponse r = heap HttpResponse(out, c.sock, 4096, 64);
            if (WsServerHandshake.isUpgradeRequest(q)) {
                WsServerHandshake.accept(q, r);
                r.finish(true, Version.HTTP_1_1, true);
                c.wr.writeAll(out.array(), out.readPosition(), out.readable());
                c.wr.flush();
                WebSocket w #= WebSocket.forServer(c.rd, c.wr);
                c.ws #= w;
                return;
            }
            boolean keep = dir != null && q.keepAlive() && !q.hasBody();
            if (dir == null) {
                r.status(404);
            } else {
                chain.run(q, r);
            }
            if (r.finish(keep, q.version(), q.method() == Method.HEAD)) {
                c.wr.writeAll(out.array(), out.readPosition(), out.readable());
            }
            c.wr.flush();
            if (!keep) {
                throw heap Exception("plain request answered and closed");
            }
        }
    }

    static void notFound(HttpResponse r) {
        r.status(404);
        return;
    }

    /** Force teardown: close the socket so a parked receive fails
     *  fast, then wait for the READER fiber to exit — a dropped conn
     *  with a live reader is a use-after-free (the suite's garbage
     *  slot-id log, 2026-08-31). */
    public void stopAll() {
        this.dead = true;
        if (this.sock != null) {
            try {
                this.sock.close();
            } catch (Exception e) {
            }
        }
        int32 spins = 0;
        while (!this.readerDone && spins < 3000) {
            Fiber.sleep(Duration.ofMillis(1L));
            spins = spins + 1;
        }
        this.stopWriter();
        return;
    }

    /** Stop the writer fiber and wait for it. */
    public void stopWriter() {
        {
            LockGuard g #= this.outMu.acquire();
            this.outStop = true;
        }
        this.outReady.release();
        while (true) {
            boolean done = false;
            {
                LockGuard g2 #= this.outMu.acquire();
                done = this.outStopped;
            }
            if (done || this.writeTask == null) {
                return;
            }
            Fiber.sleep(Duration.ofMillis(1L));
        }
    }
}
