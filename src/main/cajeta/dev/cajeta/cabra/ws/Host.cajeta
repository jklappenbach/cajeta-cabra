package dev.cajeta.cabra.ws;

import cajeta.collection.ArrayList;
import cajeta.concurrent.Channel;
import cajeta.concurrent.Fiber;
import cajeta.lang.Optional;
import cajeta.lang.String;
import cajeta.time.Clock;
import cajeta.time.Duration;
import dev.cajeta.llm.Diag;
import dev.cajeta.llm.LlmEngine;
import dev.cajeta.llm.chat.ChatTemplate;
import dev.cajeta.llm.gen.SampleParams;
import dev.cajeta.llm.gen.TokenSink;
import dev.cajeta.llm.sched.Request;
import dev.cajeta.primavera.context.TimeSource;
import dev.cajeta.primavera.web.Connection;
import dev.cajeta.primavera.web.Endpoints;
import dev.cajeta.primavera.web.JsonBody;
import dev.cajeta.primavera.web.RequestView;
import dev.cajeta.primavera.web.Response;
import dev.cajeta.primavera.web.WebServer;
import dev.cajeta.primavera.web.WebServerBuilder;
import dev.cajeta.primavera.web.WebSocketEndpoints;
import dev.cajeta.cabra.core.Sessions;
import dev.cajeta.cabra.diag.DiagQueue;
import dev.cajeta.cabra.diag.DiagnosticBridge;
import dev.cajeta.cabra.io.Utf8Chunker;
import dev.cajeta.cabra.proto.ErrKind;
import dev.cajeta.cabra.proto.Protocol;
import dev.cajeta.cabra.proto.Req;
import dev.cajeta.cabra.proto.Wire;
import dev.cajeta.cabra.stdio.Serve;
import dev.cajeta.cabra.ChatOp;

/**
 * Host mode (spec §5.1.2, plan unit 7): one loaded model, N WebSocket
 * clients, every conversation multiplexed onto the engine's continuous
 * batching. It is a primavera application (plan 12.2.2): a `WebServer`
 * serves `GET /health`, the web client as a static mount when there is a
 * web root, and the socket protocol on `/ws`. The fiber layout:
 *
 *   server fibers     — primavera's: accept, upgrade, and per connection
 *                       a receive loop running `Front`'s hooks (parse in
 *                       place, auth gate, hand the request over).
 *   per-conn writer   — primavera's: drains that connection's send ring,
 *                       so a peer that stops reading stalls only itself
 *                       (§5.3.2); past the byte bound it closes with 1008.
 *   host loop         — THIS thread: every engine call. Drains requests,
 *                       resolves sessions, submits turns, steps the
 *                       scheduler, and routes each chunk by rid -> conn
 *                       (the Serve demux with a connection column). A
 *                       chunk is encoded straight into the connection's
 *                       send ring.
 *
 * Sessions are identity + expiry only (§5.2.8): host-side KV is a
 * cache via the engine's prefix store, never pinned per session, so a
 * reconnect resumes by id and pays at most a warm re-prefill.
 */
public final class Host implements TokenSink {

    LlmEngine engine;          // owned
    Sessions reg;              // owned
    String state;

    Front front;               // owned; the connection hooks
    WebServer web;             // owned; null until listen
    Task<int32> serveTask;
    int32 queueBytes;          // each connection's send bound
    ChunkLine line;            // reused for every chunk sent
    public int32 port;
    boolean stopping;

    // In-flight table: one Turn per generation (§11.2), slot-indexed.
    int32 cap;
    int32 live;
    Turn[] turns;              // owned; slot-indexed, null = free (§11.2)
    int32 idleSteps;
    int32[] oneTok;            // the token id decode reads, reused per token

    // 7.2.4: past in-flight capacity a request QUEUES (a bounded FIFO of
    // the parsed requests themselves, moved, never copied); past the
    // bound it is shed with an explicit busy error. Admission happens as
    // reaping frees slots.
    ChatTemplate tpl;          // owned; null when the model ships none
    int32 ctxLimit;            // 0 = no admission guard
    String webDir;             // owned; null = no HTTP front (§10.1)
    // §10.9 forwarding: the queue the bridge fills while armed, the
    // bridge itself (to register with the engine on demand), whether
    // it is registered regardless (--verbose), and how many in-flight
    // requests asked.
    DiagQueue diagQ;           // borrow
    DiagnosticBridge diagBridge; // borrow
    boolean diagAlways;
    int32 diagWanted;

    int32 queueBound;
    Channel<Inbound> waitQ;    // null until first needed
    int32 qCount;

    public Host(#LlmEngine engine, String token, int32 maxConns,
            int32 maxSessions, int64 idleExpiryMs) {
        this.engine #= engine;
        this.reg = heap Sessions(maxSessions, idleExpiryMs);
        this.state = "ready";
        this.front = heap Front(token, maxConns);
        this.web = null;
        this.queueBytes = 1048576;
        this.line = heap ChunkLine();
        this.port = 0;
        this.stopping = false;
        this.cap = maxSessions;
        this.live = 0;
        this.turns = heap Turn[this.cap];
        this.idleSteps = 0;
        this.oneTok = null;
        this.diagQ = null;
        this.diagBridge = null;
        this.diagAlways = false;
        this.diagWanted = 0;
        this.tpl = null;
        this.ctxLimit = 0;
        this.webDir = null;
        this.queueBound = 8;
        this.waitQ = null;
        this.qCount = 0;
        this.engine.setSink(this);
        return;
    }

    /** §10.1: serve the built web client from `dir` as a static mount on
     *  `/` (index for `/`, assets by path, 404 otherwise). Unset, a plain
     *  GET other than `/health` is 404. Set before `listen`. */
    public void setWebRoot(String dir) {
        String d = "" + dir;
        this.webDir #= d;
        return;
    }

    /** §10.9: forward a session's records to the client that asked.
     *  `always` = the bridge is registered with the engine for the
     *  process's life (--verbose); otherwise the host registers it
     *  while at least one in-flight request wants records and
     *  unregisters after, so an unobserved engine builds nothing. */
    public void setDiag(DiagQueue q, DiagnosticBridge b, boolean always) {
        this.diagQ #= q;
        this.diagBridge #= b;
        this.diagAlways = always;
        return;
    }

    void diagArm() {
        if (this.diagQ == null) {
            return;
        }
        if (this.diagWanted == 0) {
            this.diagQ.arm();
            if (!this.diagAlways) {
                Diag.register(this.diagBridge);
            }
        }
        this.diagWanted = this.diagWanted + 1;
        return;
    }

    void diagDisarm() {
        if (this.diagQ == null || this.diagWanted == 0) {
            return;
        }
        this.diagWanted = this.diagWanted - 1;
        if (this.diagWanted == 0) {
            this.diagQ.disarm();
            if (!this.diagAlways) {
                Diag.register(null);
            }
        }
        return;
    }

    /** Host thread, after a step and BEFORE the reap: every record the
     *  step produced goes to the connection whose request asked, while
     *  the request is still mapped — so a turn's diagnostics precede
     *  its done line. Records of requests that did not ask are dropped
     *  here (the queue is armed per host, not per request). */
    void forwardDiag() {
        if (this.diagQ == null || this.diagWanted == 0) {
            return;
        }
        int32 n = this.diagQ.take();
        int32 k = 0;
        while (k < n) {
            int64 rid = this.diagQ.outSession(k);
            int32 i = 0;
            while (i < this.cap) {
                Turn t = this.turns[i];
                if (t != null && t.diag && (int64) t.rid == rid) {
                    String body #= this.diagQ.outJson(k);
                    String m #= Wire.diag(t.id, body);
                    t.say(m);
                    break;
                }
                i = i + 1;
            }
            k = k + 1;
        }
        return;
    }

    /** Install the model's chat template. Left unset (null) the `chat`
     *  op refuses — cabra never guesses a template (plan 3.2.1). */
    public void setTemplate(#ChatTemplate t) {
        this.tpl #= t;
        return;
    }

    /** Context window for the admission guard (Serve's 4.x lesson: an
     *  unadmittable prompt must be an ANSWER, not a scheduler spin).
     *  0 leaves the guard off. */
    public void setContext(int32 c) {
        this.ctxLimit = c;
        return;
    }

    /** Set before `listen`: the bytes a connection may have queued before
     *  it is closed with 1008 (each message counts its payload plus 4). */
    public void setQueueBytes(int32 n) {
        this.queueBytes = n;
        return;
    }

    /** Bind the server on loopback:`port` (0 = ephemeral) and start it
     *  serving. `port` reports what was bound. */
    public void listen(int32 port) {
        Front f = this.front;
        Endpoints api = heap Endpoints();
        api.route("GET", "/health",
            (RequestView q, Response r) -> Front.health(f, q, r));
        if (this.webDir != null) {
            api.staticDir("/", this.webDir);
        }
        WebSocketEndpoints ws = heap WebSocketEndpoints();
        ws.queueBytes(this.queueBytes);
        ws.json("/ws", (Connection c) -> Front.opened(f, c),
            (Connection c, JsonBody b) -> Front.message(f, c, b),
            (Connection c, int32 code) -> Front.closed(f, c, code));
        WebServerBuilder b #= WebServer.builder();
        b.bind("127.0.0.1:" + port);
        b.endpoints(#api);
        b.websockets(#ws);
        this.web #= b.build();
        this.port = this.web.port();
        Task<int32> t = spawn serveWeb(this);
        this.serveTask #= t;
        return;
    }

    // Shutdown awaits this fiber. A throw out of serve is reported here
    // rather than carried to shutdown, which has nothing to do with it.
    static async int32 serveWeb(Host h) {
        try {
            h.web.serve();
        } catch (Throwable t) {
            System.stderr.println("cabra: web server ended on a throw");
        }
        return 1;
    }

    /** Queue `m` for a connection; the ring copies it. A send past the
     *  byte bound closes the connection (§5.3.2): a client that stopped
     *  reading is shed rather than waited on, by primavera. */
    void say(int64 conn, String m) {
        this.web.connections().send(conn, m);
        return;
    }

    /** The host loop — run on the main thread until shutdown. */
    public void run() {
        while (!this.stopping) {
            if (this.live > 0) {
                this.driveStep();
                boolean absorbing = true;
                while (absorbing) {
                    Optional<Inbound> got = this.front.inCh.tryReceive();
                    if (got.isPresent()) {
                        Inbound e #= got.take();
                        this.dispatch(#e);
                    } else {
                        absorbing = false;
                    }
                }
            } else {
                Optional<Inbound> got = this.front.inCh.receive();
                if (got.isEmpty()) {
                    return;
                }
                Inbound e #= got.take();
                this.dispatch(#e);
            }
        }
        return;
    }

    void dispatch(#Inbound e) {
        int64 conn = e.conn;
        if (e.kind == Inbound.CLOSED) {
            this.connClosed(conn);
            return;
        }
        if (!this.front.isOpen(conn)) {
            return;
        }
        int64 nowMs = this.reg.now();
        this.reg.expire(nowMs);
        // 7.2.3: the auth gate ran in `Front` on the connection's fiber,
        // so an unauthed connection never reaches here.
        Req r #= e.req;

        if (!r.ok) {
            String m #= Wire.error(r.id, r.hasId, ErrKind.BAD_REQUEST,
                r.err, false);
            this.say(conn, #m);
            return;
        }
        if (r.op.equals("auth")) {
            this.say(conn, "{\"authed\":true}");
            return;
        }
        if (r.op.equals("shutdown")) {
            this.stopping = true;
            return;
        }
        if (r.op.equals("health")) {
            String m #= Wire.health(r.id, this.state, "");
            this.say(conn, #m);
            return;
        }
        if (r.op.equals("open")) {
            String sid #= this.reg.open(nowMs);
            if (sid == null) {
                String m #= Wire.error(r.id, r.hasId, ErrKind.CAPACITY,
                    "no session slot free", false);
                this.say(conn, #m);
                return;
            }
            String m #= Wire.opened(r.id, sid);
            this.say(conn, #m);
            return;
        }
        if (r.op.equals("close")) {
            if (!r.hasSession || !this.reg.close(r.session, nowMs)) {
                String m #= Wire.error(r.id, r.hasId,
                    ErrKind.SESSION_GONE, "close: no such open session",
                    false);
                this.say(conn, #m);
                return;
            }
            String m #= Wire.closedOk(r.id, r.session);
            this.say(conn, #m);
            return;
        }
        if (r.op.equals("cancel")) {
            // §10.5: only THIS connection's request `id` — ids are the
            // caller's, so two connections may both hold a 7. Not in
            // flight here (finished, foreign, never submitted) is a
            // refusal carrying the id; the done line (finish "cancel")
            // follows on the next reap.
            int32 slot = r.hasId ? this.slotOfId(conn, r.id) : (0 - 1);
            if (slot < 0 || !this.engine.cancel(this.turns[slot].rid)) {
                String m #= Wire.error(r.id, r.hasId, ErrKind.BAD_REQUEST,
                    "cancel: no request " + r.id
                    + " in flight on this connection", false);
                this.say(conn, #m);
            }
            return;
        }

        // generate / chat.
        if (r.hasSession) {
            int32 st = this.reg.touch(r.session, nowMs);
            if (st != Sessions.OPEN) {
                String why = st == Sessions.GONE
                    ? "session expired or closed - open a new one and resend context"
                    : "unknown session id - never issued by this host";
                String m #= Wire.error(r.id, r.hasId,
                    ErrKind.SESSION_GONE, why, true);
                this.say(conn, #m);
                return;
            }
        }
        this.submitOne(conn, #r);
        return;
    }

    /** A connection closed: its turns' output has nowhere to go, so they
     *  are cancelled, and their done lines are dropped at the reap. Its
     *  sessions survive (§5.2.2). */
    void connClosed(int64 conn) {
        int32 i = 0;
        while (i < this.cap) {
            Turn t = this.turns[i];
            if (t != null && t.conn == conn) {
                this.engine.cancel(t.rid);
            }
            i = i + 1;
        }
        return;
    }

    void submitOne(int64 conn, #Req r) {
        int32[] ids = null;
        if (r.op.equals("chat")) {
            String rendered #= ChatOp.render(this.tpl, r.messagesRaw);
            if (rendered == null) {
                String tm #= Wire.error(r.id, r.hasId,
                    ErrKind.BAD_REQUEST,
                    "this model ships no chat template - use "
                    + "\"generate\" with a raw prompt", false);
                this.say(conn, #tm);
                return;
            }
            // RAW encode: the render already carries BOS and the role
            // headers, so encodePrompt would prepend a second BOS.
            ids #= this.engine.tokenizer().encode(rendered);
        } else {
            ids #= this.engine.tokenizer().encodePrompt(r.prompt);
        }
        int32 n = (int32) ids.count();
        if (this.ctxLimit > 0 && n + r.n > this.ctxLimit) {
            String cm #= Wire.error(r.id, r.hasId, ErrKind.BAD_REQUEST,
                "prompt is " + n + " tokens and n is " + r.n
                + ", which exceeds the " + this.ctxLimit
                + "-token context", false);
            this.say(conn, #cm);
            return;
        }
        int32 slot = this.freeReqSlot();
        if (slot < 0) {
            // 7.1.5: capacity means WAIT, not refuse — until the wait
            // itself would be unbounded.
            int64 wid = r.id;
            boolean whas = r.hasId;
            if (this.enqueueWaiting(conn, #r)) {
                return;
            }
            String m #= Wire.error(wid, whas, ErrKind.CAPACITY,
                "busy: " + this.live + " in flight and the queue is full",
                false);
            this.say(conn, #m);
            return;
        }
        SampleParams p = heap SampleParams(r.temp, r.seed);
        p.topK = r.topK;
        p.topP = r.topP;
        p.repeatPenalty = r.repeatPenalty;
        int32 rid = 0;
        try {
            rid = this.engine.submitTokens(ids, n, r.n, #p);
        } catch (Throwable t) {
            String m #= Wire.error(r.id, r.hasId, ErrKind.INTERNAL,
                "submit failed", false);
            this.say(conn, #m);
            return;
        }
        this.ensureChunker();
        this.chunker.reset(slot);
        String sess = r.hasSession ? r.session : null;
        this.turns[slot] = heap Turn(rid, r.id, conn, sess, n, r.diag,
            this.web.connections(), this.line);
        if (r.diag) {
            this.diagArm();
        }
        this.live = this.live + 1;
        return;
    }

    int32 freeReqSlot() {
        int32 i = 0;
        while (i < this.cap) {
            if (this.turns[i] == null) {
                return i;
            }
            i = i + 1;
        }
        return 0 - 1;
    }

    /** Set BEFORE serving: how many requests may wait behind the
     *  in-flight table before new ones are shed (7.1.5). */
    public void setQueueBound(int32 b) {
        this.queueBound = b;
        return;
    }

    /** Queue a request behind a full in-flight table. False when the
     *  queue is at its bound: the request is dropped and the caller sheds
     *  it with a busy error. */
    boolean enqueueWaiting(int64 conn, #Req r) {
        if (this.waitQ == null) {
            this.waitQ = heap Channel<Inbound>(this.queueBound);
        }
        if (this.qCount >= this.queueBound) {
            return false;
        }
        Inbound e = heap Inbound(Inbound.MESSAGE, conn, #r);
        if (!this.waitQ.trySend(#e)) {
            return false;
        }
        this.qCount = this.qCount + 1;
        return true;
    }

    /** The next queued request, owned; null when none is waiting. */
    #Inbound takeWaiting() {
        if (this.qCount == 0) {
            return null;
        }
        Optional<Inbound> o = this.waitQ.tryReceive();
        if (!o.isPresent()) {
            return null;
        }
        this.qCount = this.qCount - 1;
        return #o.take();
    }

    /** Admit queued requests into slots reaping just freed. A queued
     *  request re-touches its session: time passed while it waited, and
     *  expiry must not be blind to that. */
    void drainQueue() {
        while (this.qCount > 0 && this.freeReqSlot() >= 0) {
            Inbound q #= this.takeWaiting();
            if (q == null) {
                return;
            }
            int64 qcs = q.conn;
            if (!this.front.isOpen(qcs)) {
                continue;
            }
            int64 nowMs = this.reg.now();
            this.reg.expire(nowMs);
            Req qr #= q.req;
            if (qr.hasSession) {
                int32 st = this.reg.touch(qr.session, nowMs);
                if (st != Sessions.OPEN) {
                    String m #= Wire.error(qr.id, qr.hasId,
                        ErrKind.SESSION_GONE,
                        "session expired while the request was queued",
                        true);
                    this.say(qcs, #m);
                    continue;
                }
            }
            this.submitOne(qcs, #qr);
        }
        return;
    }

    void driveStep() {
        if (this.live == 0) {
            this.idleSteps = 0;
            return;
        }
        try {
            this.engine.stepOnce();
        } catch (Throwable t) {
            this.failAllOpen();
            return;
        }
        this.forwardDiag();
        int32 done = this.reapFinished();
        if (done > 0) {
            this.idleSteps = 0;
            this.drainQueue();
        } else {
            this.idleSteps = this.idleSteps + 1;
            if (this.idleSteps > 4096) {
                this.failAllOpen();
                this.idleSteps = 0;
            }
        }
        return;
    }

    int32 reapFinished() {
        int32 done = 0;
        int32 i = 0;
        while (i < this.cap) {
            Turn t = this.turns[i];
            if (t != null) {
                Request q = this.engine.request(t.rid);
                if (q.finishReason() != Request.FINISH_NONE) {
                    this.ensureChunker();
                    if (this.chunker.hasTail(i)) {
                        String tailS #= this.chunker.flushTail(i);
                        if (tailS.byteLength() > 0) {
                            t.chunk(tailS);
                        }
                    }
                    String finish = "budget";
                    if (q.finishReason() == Request.FINISH_EOS) {
                        finish = "eos";
                    }
                    if (q.finishReason() == Request.FINISH_STOP) {
                        finish = "stop";
                    }
                    if (q.finishReason() == Request.FINISH_CANCEL) {
                        finish = "cancel";
                    }
                    // §3.1.2: the done line carries usage on this
                    // transport too — the web client shows it.
                    int64 endNs = Clock.nanoTime();
                    int64 pMs = 0L;
                    int64 dMs = 0L;
                    if (t.firstNs > 0L) {
                        pMs = (t.firstNs - t.t0Ns) / 1000000L;
                        dMs = (endNs - t.firstNs) / 1000000L;
                    } else {
                        pMs = (endNs - t.t0Ns) / 1000000L;
                    }
                    String m #= Wire.doneUsage(t.id, finish,
                        (int64) t.promptLen,
                        (int64) q.generatedCount(), pMs, dMs);
                    t.say(m);
                    boolean wanted = t.diag;
                    this.turns[i] = null;
                    if (wanted) {
                        this.diagDisarm();
                    }
                    this.live = this.live - 1;
                    done = done + 1;
                }
            }
            i = i + 1;
        }
        return done;
    }

    void failAllOpen() {
        int32 i = 0;
        while (i < this.cap) {
            Turn t = this.turns[i];
            if (t != null) {
                String m #= Wire.done(t.id, "error");
                t.say(m);
                boolean wanted = t.diag;
                this.turns[i] = null;
                if (wanted) {
                    this.diagDisarm();
                }
            }
            i = i + 1;
        }
        // Nothing queued behind a failed engine gets to start.
        while (this.qCount > 0) {
            Inbound q #= this.takeWaiting();
            if (q == null) {
                break;
            }
            String qm #= Wire.error(q.req.id, q.req.hasId, ErrKind.INTERNAL,
                "engine failed before this request started", false);
            this.say(q.conn, #qm);
        }
        this.live = 0;
        return;
    }

    // UTF-8 hold-back — shared with the stdio path via Utf8Chunker
    // (same request, same transcript, whichever wire carried it).
    Utf8Chunker chunker;

    void ensureChunker() {
        if (this.chunker == null) {
            this.chunker = heap Utf8Chunker(this.cap);
        }
        return;
    }

    /** The in-flight slot carrying caller id `id` on `conn`, or -1. */
    int32 slotOfId(int64 conn, int64 id) {
        int32 i = 0;
        while (i < this.cap) {
            Turn t = this.turns[i];
            if (t != null && t.conn == conn && t.id == id) {
                return i;
            }
            i = i + 1;
        }
        return 0 - 1;
    }

    /** TokenSink: rid -> its turn; decode one token, hold back
     *  any incomplete UTF-8 tail, enqueue the complete part. */
    public void onToken(int32 reqId, int32 tok) {
        if (this.engine.isEog(tok)) {
            return;
        }
        int32 i = 0;
        while (i < this.cap) {
            Turn t = this.turns[i];
            if (t != null && t.rid == reqId) {
                t.tokenArrived();
                this.ensureChunker();
                if (this.oneTok == null) {
                    this.oneTok = heap int32[1];
                }
                this.oneTok[0] = tok;
                int8[] raw #= this.engine.tokenizer().decode(this.oneTok, 1);
                String s #= this.chunker.takeOwned(i, #raw);
                if (s.byteLength() > 0) {
                    t.chunk(s);
                }
                return;
            }
            i = i + 1;
        }
        return;
    }

    /** Stop: no more requests reach the loop, every connection closes
     *  with 1001, and the server's fibers end. */
    public void shutdown() {
        this.stopping = true;
        this.front.inCh.close();
        if (this.web != null) {
            this.web.shutdown(Duration.ofSeconds(2L));
            int32 served = await this.serveTask;
            // A close hook can still be running after the server stops,
            // and it reads the front: wait for the last one to finish.
            int32 polls = 0;
            while (this.front.liveCount() > 0 && polls < 400) {
                Fiber.sleep(Duration.ofMillis(5L));
                polls = polls + 1;
            }
        }
        return;
    }

    /** The close code of the connection that closed last, or 0. */
    public int32 lastCloseCode() {
        if (this.web == null) {
            return 0;
        }
        return this.web.connections().lastCloseCode();
    }

    /** Install the clock sessions expire by (plan 12.1.2); the caller keeps
     *  it alive while the host runs. Turn timing stays on the monotonic clock. */
    public void useClock(^TimeSource c) {
        this.reg.useClock(c);
        return;
    }

    public int32 openSessions() {
        return this.reg.openCount();
    }

    /** Prefix blocks adopted instead of recomputed — the observable
     *  behind 8.1.2's warm-resume claim. */
    public int32 adoptedBlocks() {
        return this.engine.scheduler().adoptedBlocks();
    }
}
