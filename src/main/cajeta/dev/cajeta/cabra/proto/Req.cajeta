package dev.cajeta.cabra.proto;

import cajeta.collection.ArrayList;
import cajeta.lang.String;
import dev.cajeta.cabra.ws.Host;

/**
 * One parsed protocol request (spec §3.1.1). Every string field is an
 * OWNED copy — nothing borrows into the parsed JsonValue, so a Req
 * outlives the line it came from (the returned-object-owning-arrays
 * rule: fields stored with `#=`, values moved in).
 *
 * `ok == false` means the line did not yield a runnable request; `err`
 * says why, and the serve loop answers with an error object and
 * CONTINUES — a malformed line must never kill the server.
 */
public final class Req {

    public boolean ok;
    public String err;

    public String op;
    public boolean hasId;
    public int64 id;

    // Session addressing (spec 5.2.1): present when the request names
    // the conversation it belongs to; absent = one-shot, the original
    // stdio behaviour.
    public boolean hasSession;
    public int64 session;

    // Host-mode auth (spec 5.5.1): the token presented on connect.
    public String token;

    public String prompt;      // generate
    public String messagesRaw; // chat: the messages array re-serialized

    // Sampling (spec §3.2) — defaults documented here and pinned by
    // ProtocolTest: n=256, temp=0 (deterministic), top_k=40, top_p=0.95,
    // repeat_penalty=1.0, seed=0.
    public int32 n;
    public boolean diag;       // §10.9: forward this request's records
    public float32 temp;
    public int32 topK;
    public float32 topP;
    public float32 repeatPenalty;
    public int64 seed;

    // Halting strings (spec §4.3). The engine checks these against a
    // rolling detokenized tail (SampleParams.stops), so cabra hands them
    // straight through rather than truncating after the fact — a
    // post-hoc trim would still have STREAMED the text it meant to
    // suppress. Null when the request named none.
    public ArrayList<String> stops;

    public Req() {
        this.ok = false;
        this.err = "";
        this.op = "";
        this.hasId = false;
        this.id = 0L;
        this.hasSession = false;
        this.session = 0L;
        this.token = "";
        this.prompt = "";
        this.messagesRaw = "";
        this.n = 256;
        this.temp = 0.0f;
        this.topK = 40;
        this.topP = 0.95f;
        this.repeatPenalty = 1.0f;
        this.seed = 0L;
        this.stops = null;
        this.diag = false;
    }
}
