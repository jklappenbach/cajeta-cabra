package dev.cajeta.cabra.proto;

import cajeta.lang.String;

/**
 * Response rendering for the transport-neutral core: each op's answer
 * as ONE string message, framed by whichever transport carries it.
 * (`Protocol`'s emitters write through a JsonLinesWriter into a file
 * sink — right for stdio, useless for a seam that hands out strings.)
 *
 * The only free text on the wire is chunk text and error messages;
 * `esc` covers the JSON string escapes they can contain.
 */
public final class Wire {

    public Wire() { return; }

    /** JSON string-escape: backslash, quote, and the control range. */
    public static #String esc(String s) {
        int8[] b #= s.toBytes();
        String out = "";
        int32 i = 0;
        int32 start = 0;
        while (i < (int32) b.count()) {
            int32 c = (int32) b[i];
            if (c < 0) { c = c + 256; }
            boolean needs = c == 34 || c == 92 || c < 32;
            if (needs) {
                if (i > start) {
                    String pre #= s.substring(start, i);
                    out = out + pre;
                }
                if (c == 34) { out = out + "\\\""; }
                else if (c == 92) { out = out + "\\\\"; }
                else if (c == 10) { out = out + "\\n"; }
                else if (c == 13) { out = out + "\\r"; }
                else if (c == 9) { out = out + "\\t"; }
                else {
                    // Real \u00XX for the control byte - the earlier
                    // placeholder rewrote EOT/SO/etc to NUL and broke
                    // transport-equality by one byte (2026-08-31).
                    out = out + "\\u00" + Wire.hexDigit(c / 16)
                        + Wire.hexDigit(c % 16);
                }
                start = i + 1;
            }
            i = i + 1;
        }
        if (start == 0) {
            return #= Wire.cp(s);
        }
        if (i > start) {
            String tail #= s.substring(start, i);
            out = out + tail;
        }
        return #= Wire.cp(out);
    }

    static String hexDigit(int32 v) {
        if (v == 0) { return "0"; }
        if (v == 1) { return "1"; }
        if (v == 2) { return "2"; }
        if (v == 3) { return "3"; }
        if (v == 4) { return "4"; }
        if (v == 5) { return "5"; }
        if (v == 6) { return "6"; }
        if (v == 7) { return "7"; }
        if (v == 8) { return "8"; }
        if (v == 9) { return "9"; }
        if (v == 10) { return "a"; }
        if (v == 11) { return "b"; }
        if (v == 12) { return "c"; }
        if (v == 13) { return "d"; }
        if (v == 14) { return "e"; }
        return "f";
    }

    static #String cp(String s) {
        int8[] b #= s.toBytes();
        String c = heap String(#b, s.byteLength());
        return #= c;
    }

    public static #String opened(int64 id, int64 session) {
        return #= "{\"id\":" + id + ",\"session\":" + session + "}";
    }

    public static #String closedOk(int64 id, int64 session) {
        return #= "{\"id\":" + id + ",\"closed\":" + session + "}";
    }

    public static #String chunk(int64 id, String text) {
        String e #= Wire.esc(text);
        return #= "{\"id\":" + id + ",\"chunk\":\"" + e + "\"}";
    }

    public static #String done(int64 id, String finish) {
        return #= "{\"id\":" + id + ",\"done\":true,\"finish\":\""
            + finish + "\"}";
    }

    public static #String health(int64 id, String state, String model) {
        String e #= Wire.esc(model);
        return #= "{\"id\":" + id + ",\"state\":\"" + state
            + "\",\"model\":\"" + e + "\"}";
    }

    /** A kinded error (§4.5). `fatal` says whether the session it names
     *  survives (§4.5.4). */
    public static #String error(int64 id, boolean hasId, String kind,
            String msg, boolean fatal) {
        String e #= Wire.esc(msg);
        String idPart = hasId ? ("\"id\":" + id + ",") : "";
        String fatalPart = fatal ? ",\"session_ended\":true" : "";
        return #= "{" + idPart + "\"error\":\"" + e + "\",\"kind\":\""
            + kind + "\"" + fatalPart + "}";
    }
}
