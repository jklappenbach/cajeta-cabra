package dev.cajeta.cabra.selftest;

import cajeta.concurrent.Fiber;
import cajeta.time.Duration;
import cajeta.codec.json.Json;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.IpAddress;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;
import cajeta.io.net.uri.Uri;
import cajeta.lang.String;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.http.ws.WebSocket;
import dev.cajeta.http.ws.WsMessage;
import dev.cajeta.http.ws.WsUpgrade;
import dev.cajeta.llm.LlmEngine;
import dev.cajeta.primavera.context.ManualTimeSource;
import dev.cajeta.cabra.proto.ErrKind;
import dev.cajeta.cabra.ws.Host;

/**
 * Plan 7.1 — host mode over WebSocket, in-process on loopback: the
 * host loop runs on the test's thread while client FIBERS connect,
 * auth, open sessions, and drive turns against ONE toy engine (7.1.2's
 * one-model-load claim is structural here: there is exactly one
 * LlmEngine in the process).
 */
public class HostTest {

    static final String TOKEN = "sesame";

    /** One scripted client's run and its evidence. */
    static class ClientRun {
        public int32 port;
        public String prompt;
        public int64 wireId;
        public String acc;      // concatenated chunk text
        public String finish;
        public String session;
        public boolean sawAuthed;
        public boolean closedEarly;
        public boolean sendShutdown;
        public ClientRun waitFor;   // finish first, before any shutdown
        public ClientRun() {
            this.port = 0;
            this.prompt = "";
            this.wireId = 0L;
            this.acc = "";
            this.finish = "";
            this.session = null;
            this.sawAuthed = false;
            this.closedEarly = false;
            this.sendShutdown = false;
            this.waitFor = null;
        }
    }

    /** Evidence for the 7.1.5 triple: id 11 runs, id 12 queues then
     *  runs, id 13 is shed past the queue bound. */
    static class QueueRun {
        public int32 port;
        public String session;
        public String acc12;
        public String finish11;
        public String finish12;
        public String errKind13;
        public QueueRun() {
            this.port = 0;
            this.session = null;
            this.acc12 = "";
            this.finish11 = "";
            this.finish12 = "";
            this.errKind13 = "";
        }
    }

    public HostTest() { return; }

    static #WebSocket dial(int32 port, AsyncReader rd, AsyncWriter wr) {
        Uri u #= Uri.builder().scheme("ws").host("127.0.0.1")
            .port(port).path("/ws").build();
        return #WsUpgrade.connectClient(rd, wr, u, 424242);
    }

    static #String recvText(WebSocket ws) {
        WsMessage m #= ws.receive();
        if (m == null) {
            return null;
        }
        return #m.text();
    }

    static async int32 runClient(ClientRun cr) {
        IpAddress a #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#a, cr.port);
        TcpStream sock #= TcpStream.connectAsync(#addr);
        AsyncReader rd = heap AsyncReader(sock);
        AsyncWriter wr = heap AsyncWriter(sock);
        WebSocket ws #= HostTest.dial(cr.port, rd, wr);

        ws.send("{\"op\":\"auth\",\"token\":\"" + HostTest.TOKEN + "\"}");
        String au #= HostTest.recvText(ws);
        if (au == null || !au.contains("authed")) {
            cr.closedEarly = true;
            sock.close();
            return 0;
        }
        cr.sawAuthed = true;

        ws.send("{\"op\":\"open\",\"id\":" + cr.wireId + "}");
        String op #= HostTest.recvText(ws);
        JsonValue ov #= Json.parse(op);
        cr.session #= "" + ov.object().get("session").asString();

        ws.send("{\"op\":\"generate\",\"id\":" + cr.wireId
            + ",\"session\":\"" + cr.session + "\",\"prompt\":\""
            + cr.prompt + "\",\"n\":6,\"temp\":0}");
        while (true) {
            String line #= HostTest.recvText(ws);
            if (line == null) {
                break;
            }
            JsonValue v #= Json.parse(line);
            JsonObject o = v.object();
            if (o.containsKey("chunk")) {
                String ctext #= o.get("chunk").asString();
                cr.acc = cr.acc + ctext;
            } else if (o.containsKey("done")) {
                String f #= o.get("finish").asString();
                cr.finish #= f;
                break;
            }
        }
        if (cr.sendShutdown) {
            // Never take the host down under someone else's turn.
            int32 tries = 0;
            while (cr.waitFor != null
                    && cr.waitFor.finish.byteLength() == 0
                    && tries < 1000) {
                Fiber.sleep(Duration.ofMillis(5L));
                tries = tries + 1;
            }
            ws.send("{\"op\":\"shutdown\"}");
            // Let the frame FLUSH: close-on-send loses the buffered
            // frame and the host loop waits forever (measured — the
            // 61-minute suite wedge was exactly this).
            Fiber.sleep(Duration.ofMillis(200L));
        }
        sock.close();
        return 0;
    }

    /** A client that skips auth: its first real op must get the
     *  connection CLOSED before any answer (7.1.4). */
    static async int32 runUnauthed(ClientRun cr) {
        IpAddress a #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#a, cr.port);
        TcpStream sock #= TcpStream.connectAsync(#addr);
        AsyncReader rd = heap AsyncReader(sock);
        AsyncWriter wr = heap AsyncWriter(sock);
        WebSocket ws #= HostTest.dial(cr.port, rd, wr);
        ws.send("{\"op\":\"open\",\"id\":9}");
        String ans = null;
        try {
            ans #= HostTest.recvText(ws);
        } catch (Exception e) {
        }
        cr.closedEarly = ans == null;
        sock.close();
        return 0;
    }

    /** Waits for the unauthed probe to be refused, then auths and shuts
     *  the host down so the test's host loop can return. */
    static async int32 runShutdowner(ClientRun cr, ClientRun watched) {
        int32 tries = 0;
        while (!watched.closedEarly && tries < 1000) {
            Fiber.sleep(Duration.ofMillis(5L));
            tries = tries + 1;
        }
        IpAddress a #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#a, cr.port);
        TcpStream sock #= TcpStream.connectAsync(#addr);
        AsyncReader rd = heap AsyncReader(sock);
        AsyncWriter wr = heap AsyncWriter(sock);
        WebSocket ws #= HostTest.dial(cr.port, rd, wr);
        ws.send("{\"op\":\"auth\",\"token\":\"" + HostTest.TOKEN + "\"}");
        String au #= HostTest.recvText(ws);
        cr.sawAuthed = au != null && au.contains("authed");
        ws.send("{\"op\":\"shutdown\"}");
        Fiber.sleep(Duration.ofMillis(200L));
        sock.close();
        return 0;
    }

    /** 7.1.1 + 7.1.2 — two clients, one engine: own sessions, own
     *  outputs, both correct against their prompts' solo runs. */
    @Test
    public void twoClientsShareOneModelAndKeepTheirOutputs() {
        String soloA #= ConcurrencyTest.serialRun("tmp/ht-solo-a.jsonl",
            1L, ConcurrencyTest.PROMPT_A);
        String soloB #= ConcurrencyTest.serialRun("tmp/ht-solo-b.jsonl",
            2L, ConcurrencyTest.PROMPT_B);
        Assert.isFalse(soloA.equals(soloB));

        LlmEngine e #= ConcurrencyTest.engine(2);
        Host h = heap Host(#e, HostTest.TOKEN, 4, 2, 60000L);
        h.listen(0);

        ClientRun ca = heap ClientRun();
        ca.port = h.port;
        ca.prompt = ConcurrencyTest.PROMPT_A;
        ca.wireId = 1L;
        ClientRun cb = heap ClientRun();
        cb.port = h.port;
        cb.prompt = ConcurrencyTest.PROMPT_B;
        cb.wireId = 2L;
        cb.sendShutdown = true;
        cb.waitFor = ca;

        scope {
            spawn runClient(ca);
            spawn runClient(cb);
            h.run();
            h.shutdown();
        }

        Assert.isTrue(ca.sawAuthed);
        Assert.isTrue(cb.sawAuthed);
        Assert.isTrue(ca.session != null && cb.session != null);
        Assert.isFalse(ca.session.equals(cb.session));
        Assert.isTrue(ca.acc.equals(soloA));
        Assert.isTrue(cb.acc.equals(soloB));
        Assert.isTrue(ca.finish.byteLength() > 0);
        Assert.isTrue(cb.finish.byteLength() > 0);
    }

    /** 7.1.4 — no token, no service: the connection closes before any
     *  op is processed. */
    @Test
    public void aConnectionWithoutATokenIsClosedFirst() {
        LlmEngine e #= ConcurrencyTest.engine(1);
        Host h = heap Host(#e, HostTest.TOKEN, 2, 1, 60000L);
        h.listen(0);
        ClientRun cu = heap ClientRun();
        cu.port = h.port;
        ClientRun cw = heap ClientRun();
        cw.port = h.port;
        scope {
            spawn runUnauthed(cu);
            spawn runShutdowner(cw, cu);
            h.run();
            h.shutdown();
        }
        Assert.isTrue(cu.closedEarly);
        Assert.isTrue(cw.sawAuthed);
    }

    /** Sends one chat op (the toy ships no template), records the
     *  reply, then shuts the host down. */
    static async int32 runChatProbe(ClientRun cr) {
        IpAddress a #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#a, cr.port);
        TcpStream sock #= TcpStream.connectAsync(#addr);
        AsyncReader rd = heap AsyncReader(sock);
        AsyncWriter wr = heap AsyncWriter(sock);
        WebSocket ws #= HostTest.dial(cr.port, rd, wr);
        ws.send("{\"op\":\"auth\",\"token\":\"" + HostTest.TOKEN + "\"}");
        String au #= HostTest.recvText(ws);
        cr.sawAuthed = au != null && au.contains("authed");
        ws.send("{\"op\":\"chat\",\"id\":41,\"messages\":"
            + "[{\"role\":\"user\",\"content\":\"hi\"}],\"n\":2}");
        String rep #= HostTest.recvText(ws);
        if (rep != null) {
            cr.acc #= rep;
        }
        ws.send("{\"op\":\"shutdown\"}");
        Fiber.sleep(Duration.ofMillis(200L));
        sock.close();
        return 0;
    }

    /** Host-mode chat parity with Serve: a chat op against a model
     *  with no template is REFUSED with a template error — never run
     *  as a bare generate of an empty prompt. */
    @Test
    public void chatWithoutATemplateIsRefusedNotMisrun() {
        LlmEngine e #= ConcurrencyTest.engine(1);
        Host h = heap Host(#e, HostTest.TOKEN, 2, 1, 60000L);
        h.listen(0);
        ClientRun cc = heap ClientRun();
        cc.port = h.port;
        scope {
            spawn runChatProbe(cc);
            h.run();
            h.shutdown();
        }
        Assert.isTrue(cc.sawAuthed);
        Assert.isTrue(cc.acc.contains("template"));
        Assert.isTrue(cc.acc.contains("error"));
    }

    /** 7.1.3 — auths, opens, records its session, then VANISHES: the
     *  socket closes with no close op, as a crashed client would. */
    static async int32 runVanisher(ClientRun cr) {
        IpAddress a #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#a, cr.port);
        TcpStream sock #= TcpStream.connectAsync(#addr);
        AsyncReader rd = heap AsyncReader(sock);
        AsyncWriter wr = heap AsyncWriter(sock);
        WebSocket ws #= HostTest.dial(cr.port, rd, wr);
        ws.send("{\"op\":\"auth\",\"token\":\"" + HostTest.TOKEN + "\"}");
        String au #= HostTest.recvText(ws);
        cr.sawAuthed = au != null && au.contains("authed");
        ws.send("{\"op\":\"open\",\"id\":31}");
        String op #= HostTest.recvText(ws);
        JsonValue ov #= Json.parse(op);
        cr.session #= "" + ov.object().get("session").asString();
        sock.close();
        return 0;
    }

    /** Waits past the idle expiry, then opens against the size-1
     *  registry the vanished client filled: success is only possible
     *  through reclaim (7.1.3). */
    static async int32 runReclaimer(ClientRun cr, ClientRun dead) {
        int32 tries = 0;
        while (dead.session == null && tries < 1000) {
            Fiber.sleep(Duration.ofMillis(5L));
            tries = tries + 1;
        }
        Fiber.sleep(Duration.ofMillis(600L));
        IpAddress a #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#a, cr.port);
        TcpStream sock #= TcpStream.connectAsync(#addr);
        AsyncReader rd = heap AsyncReader(sock);
        AsyncWriter wr = heap AsyncWriter(sock);
        WebSocket ws #= HostTest.dial(cr.port, rd, wr);
        ws.send("{\"op\":\"auth\",\"token\":\"" + HostTest.TOKEN + "\"}");
        String au #= HostTest.recvText(ws);
        cr.sawAuthed = au != null && au.contains("authed");
        ws.send("{\"op\":\"open\",\"id\":32}");
        String op #= HostTest.recvText(ws);
        if (op != null && op.contains("\"session\"")) {
            JsonValue ov #= Json.parse(op);
            cr.session #= "" + ov.object().get("session").asString();
        }
        ws.send("{\"op\":\"shutdown\"}");
        Fiber.sleep(Duration.ofMillis(200L));
        sock.close();
        return 0;
    }

    /** 7.1.6 — opens a turn, then STOPS READING: its whole stream sits
     *  unread while the watched watched client's turn must still finish. */
    static async int32 runMute(ClientRun cr, ClientRun watched) {
        IpAddress a #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#a, cr.port);
        TcpStream sock #= TcpStream.connectAsync(#addr);
        AsyncReader rd = heap AsyncReader(sock);
        AsyncWriter wr = heap AsyncWriter(sock);
        WebSocket ws #= HostTest.dial(cr.port, rd, wr);
        ws.send("{\"op\":\"auth\",\"token\":\"" + HostTest.TOKEN + "\"}");
        String au #= HostTest.recvText(ws);
        cr.sawAuthed = au != null && au.contains("authed");
        ws.send("{\"op\":\"open\",\"id\":" + cr.wireId + "}");
        String op #= HostTest.recvText(ws);
        JsonValue ov #= Json.parse(op);
        cr.session #= "" + ov.object().get("session").asString();
        ws.send("{\"op\":\"generate\",\"id\":" + cr.wireId
            + ",\"session\":\"" + cr.session + "\",\"prompt\":\""
            + ConcurrencyTest.PROMPT_A + "\",\"n\":16,\"temp\":0}");
        int32 tries = 0;
        while (watched.finish.byteLength() == 0 && tries < 2000) {
            Fiber.sleep(Duration.ofMillis(5L));
            tries = tries + 1;
        }
        sock.close();
        return 0;
    }

    /** 7.1.5 — one connection, three back-to-back generates against a
     *  single in-flight slot with queue bound 1. */
    static async int32 runQueueTriple(QueueRun qr) {
        IpAddress a #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#a, qr.port);
        TcpStream sock #= TcpStream.connectAsync(#addr);
        AsyncReader rd = heap AsyncReader(sock);
        AsyncWriter wr = heap AsyncWriter(sock);
        WebSocket ws #= HostTest.dial(qr.port, rd, wr);
        ws.send("{\"op\":\"auth\",\"token\":\"" + HostTest.TOKEN + "\"}");
        String au #= HostTest.recvText(ws);
        if (au == null) {
            sock.close();
            return 0;
        }
        ws.send("{\"op\":\"open\",\"id\":10}");
        String op #= HostTest.recvText(ws);
        JsonValue ov #= Json.parse(op);
        qr.session #= "" + ov.object().get("session").asString();
        // Back to back, no reads in between: 11 must still occupy the
        // one slot when 12 and 13 arrive behind it. A big budget on the
        // roomy engine keeps 11 in flight for a real interval, so 12
        // queues and 13 sheds regardless of core count — with n=64 on
        // the 128-ctx toy, 11 finished before 12 was even dispatched on
        // a 2-core box, 12 took the freed slot, 13 was ADMITTED (never
        // shed), and the client waited forever for the CAPACITY error.
        ws.send("{\"op\":\"generate\",\"id\":11,\"session\":\"" + qr.session
            + "\",\"prompt\":\"" + ConcurrencyTest.PROMPT_A
            + "\",\"n\":1500,\"temp\":0}");
        ws.send("{\"op\":\"generate\",\"id\":12,\"session\":\"" + qr.session
            + "\",\"prompt\":\"" + ConcurrencyTest.PROMPT_B
            + "\",\"n\":6,\"temp\":0}");
        ws.send("{\"op\":\"generate\",\"id\":13,\"session\":\"" + qr.session
            + "\",\"prompt\":\"" + ConcurrencyTest.PROMPT_A
            + "\",\"n\":6,\"temp\":0}");
        while (true) {
            String line #= HostTest.recvText(ws);
            if (line == null) {
                break;
            }
            JsonValue v #= Json.parse(line);
            JsonObject o = v.object();
            int64 id = 0L - 1L;
            if (o.containsKey("id")) {
                id = o.get("id").asInt64();
            }
            if (o.containsKey("error")) {
                if (id == 13L) {
                    String k #= o.get("kind").asString();
                    qr.errKind13 #= k;
                }
                if (id == 12L) {
                    // A refusal of 12 is a queue that is NOT there —
                    // terminal evidence, never something to wait past.
                    qr.finish12 = "refused";
                }
            } else if (o.containsKey("chunk")) {
                if (id == 12L) {
                    String t #= o.get("chunk").asString();
                    qr.acc12 = qr.acc12 + t;
                }
            } else if (o.containsKey("done")) {
                String f #= o.get("finish").asString();
                if (id == 11L) {
                    qr.finish11 #= f;
                }
                if (id == 12L) {
                    qr.finish12 #= f;
                }
            }
            if (qr.finish11.byteLength() > 0
                    && qr.finish12.byteLength() > 0
                    && qr.errKind13.byteLength() > 0) {
                break;
            }
        }
        ws.send("{\"op\":\"shutdown\"}");
        Fiber.sleep(Duration.ofMillis(200L));
        sock.close();
        return 0;
    }

    /** 7.1.3 — a client that dies without closing has its session
     *  reclaimed by expiry: one session slot, 250ms idle bound, and a
     *  later open succeeds with a NEW sid. */
    @Test
    public void aDeadClientsSessionIsReclaimedByExpiry() {
        LlmEngine e #= ConcurrencyTest.engine(1);
        Host h = heap Host(#e, HostTest.TOKEN, 4, 1, 250L);
        h.listen(0);
        ClientRun cv = heap ClientRun();
        cv.port = h.port;
        ClientRun cr = heap ClientRun();
        cr.port = h.port;
        scope {
            spawn runVanisher(cv);
            spawn runReclaimer(cr, cv);
            h.run();
            h.shutdown();
        }
        Assert.isTrue(cv.session != null);
        Assert.isTrue(cr.session != null);
        // A fresh session, not the leaked one handed back.
        Assert.isFalse(cv.session.equals(cr.session));
    }

    /** 7.1.5 + 7.2.4 — beyond capacity a request queues and later runs
     *  (id 12, byte-equal to its solo); beyond the queue bound it is
     *  shed with an explicit busy error (id 13, kind=capacity). */
    @Test
    public void beyondCapacityQueuesThenRunsBeyondTheBoundSheds() {
        String soloB #= ConcurrencyTest.serialRun("tmp/ht-q-b.jsonl",
            12L, ConcurrencyTest.PROMPT_B);
        // Roomy so id 11's big budget keeps it in flight while 12 queues
        // and 13 sheds — see runQueueTriple. One slot, queue bound 1.
        LlmEngine e #= ConcurrencyTest.roomyEngine(1);
        Host h = heap Host(#e, HostTest.TOKEN, 2, 1, 60000L);
        h.setQueueBound(1);
        h.listen(0);
        QueueRun q = heap QueueRun();
        q.port = h.port;
        scope {
            spawn runQueueTriple(q);
            h.run();
            h.shutdown();
        }
        Assert.isTrue(q.finish11.byteLength() > 0);
        Assert.isTrue(q.acc12.equals(soloB));
        Assert.isTrue(q.errKind13.equals(ErrKind.CAPACITY));
    }

    /** 7.1.6 — a client that stops reading does not stall other
     *  sessions: F's turn completes byte-for-byte while S never reads
     *  a frame of its own stream. */
    @Test
    public void aClientThatStopsReadingDoesNotStallOthers() {
        String soloB #= ConcurrencyTest.serialRun("tmp/ht-mute-b.jsonl",
            22L, ConcurrencyTest.PROMPT_B);
        LlmEngine e #= ConcurrencyTest.engine(2);
        Host h = heap Host(#e, HostTest.TOKEN, 4, 2, 60000L);
        h.listen(0);
        ClientRun cs = heap ClientRun();
        cs.port = h.port;
        cs.wireId = 21L;
        ClientRun cf = heap ClientRun();
        cf.port = h.port;
        cf.wireId = 22L;
        cf.prompt = ConcurrencyTest.PROMPT_B;
        cf.sendShutdown = true;
        scope {
            spawn runMute(cs, cf);
            spawn runClient(cf);
            h.run();
            h.shutdown();
        }
        Assert.isTrue(cs.sawAuthed);
        Assert.isTrue(cf.acc.equals(soloB));
        Assert.isTrue(cf.finish.byteLength() > 0);
    }

    /** Evidence for 12.1.5: the turn that overran the bound, and the
     *  same session resolved by id on a second connection. */
    static class BoundRun {
        public int32 port;
        public String session;
        public boolean firstCut;    // the first connection ended before done
        public String finish2;
        public int32 code1;         // the server's close code for the first
        public BoundRun() {
            this.port = 0;
            this.session = null;
            this.firstCut = false;
            this.finish2 = "";
            this.code1 = 0;
        }
    }

    static #WebSocket dialAuthed(int32 port, AsyncReader rd, AsyncWriter wr) {
        WebSocket ws #= HostTest.dial(port, rd, wr);
        ws.send("{\"op\":\"auth\",\"token\":\"" + HostTest.TOKEN + "\"}");
        String au #= HostTest.recvText(ws);
        return #ws;
    }

    /** 12.1.5: the done line is larger than the connection's byte bound,
     *  so the first turn's connection is closed before it arrives. The
     *  session outlives the connection: a second one resumes it by id. */
    static async int32 runOverBound(BoundRun br, Host h) {
        IpAddress a #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#a, br.port);
        TcpStream sock #= TcpStream.connectAsync(#addr);
        AsyncReader rd = heap AsyncReader(sock);
        AsyncWriter wr = heap AsyncWriter(sock);
        WebSocket ws #= HostTest.dialAuthed(br.port, rd, wr);
        ws.send("{\"op\":\"open\",\"id\":51}");
        String op #= HostTest.recvText(ws);
        JsonValue ov #= Json.parse(op);
        br.session #= "" + ov.object().get("session").asString();
        ws.send("{\"op\":\"generate\",\"id\":52,\"session\":\"" + br.session
            + "\",\"prompt\":\"" + ConcurrencyTest.PROMPT_A
            + "\",\"n\":3,\"temp\":0}");
        br.firstCut = true;
        while (true) {
            String line = null;
            try {
                line #= HostTest.recvText(ws);
            } catch (Exception e) {
                line = null;
            }
            if (line == null) {
                break;
            }
            if (line.contains("\"done\"")) {
                br.firstCut = false;
                break;
            }
        }
        sock.close();
        int32 tries = 0;
        while (h.lastCloseCode() == 0 && tries < 400) {
            Fiber.sleep(Duration.ofMillis(5L));
            tries = tries + 1;
        }
        br.code1 = h.lastCloseCode();

        TcpStream s2 #= TcpStream.connectAsync(SocketAddress.parse("127.0.0.1:" + br.port));
        AsyncReader rd2 = heap AsyncReader(s2);
        AsyncWriter wr2 = heap AsyncWriter(s2);
        WebSocket w2 #= HostTest.dialAuthed(br.port, rd2, wr2);
        // Resolving the session by id from the new connection: `close`
        // answers `closed` (67 bytes, under the bound) only for an open
        // session; `session_gone` is longer than the bound, so a gone
        // session would read as a cut.
        w2.send("{\"op\":\"close\",\"id\":53,\"session\":\"" + br.session + "\"}");
        String reply = null;
        try {
            reply #= HostTest.recvText(w2);
        } catch (Exception e) {
            reply = null;
        }
        if (reply == null) {
            br.finish2 = "cut";
        } else if (reply.contains("\"closed\"")) {
            br.finish2 = "closed";
        } else {
            br.finish2 #= reply;
        }
        s2.close();

        // The second connection was cut by its done line too: a third
        // takes the host down.
        TcpStream s3 #= TcpStream.connectAsync(SocketAddress.parse("127.0.0.1:" + br.port));
        AsyncReader rd3 = heap AsyncReader(s3);
        AsyncWriter wr3 = heap AsyncWriter(s3);
        WebSocket w3 #= HostTest.dialAuthed(br.port, rd3, wr3);
        w3.send("{\"op\":\"shutdown\"}");
        Fiber.sleep(Duration.ofMillis(200L));
        s3.close();
        return 0;
    }

    /** Evidence for 12.1.3: two turns' chunks, one connection. */
    static class PairRun {
        public int32 port;
        public String accA;
        public String accB;
        public String finA;
        public String finB;
        public String sidA;
        public String sidB;
        public PairRun() {
            this.port = 0;
            this.accA = "";
            this.accB = "";
            this.finA = "";
            this.finB = "";
            this.sidA = null;
            this.sidB = null;
        }
    }

    static #String openOn(WebSocket ws, int64 id) {
        ws.send("{\"op\":\"open\",\"id\":" + id + "}");
        String op #= HostTest.recvText(ws);
        JsonValue ov #= Json.parse(op);
        return #= "" + ov.object().get("session").asString();
    }

    /** 12.1.3: two sessions on ONE connection, two generates back to back,
     *  read interleaved; each id's chunks are collected apart. */
    static async int32 runPair(PairRun pr) {
        IpAddress a #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#a, pr.port);
        TcpStream sock #= TcpStream.connectAsync(#addr);
        AsyncReader rd = heap AsyncReader(sock);
        AsyncWriter wr = heap AsyncWriter(sock);
        WebSocket ws #= HostTest.dialAuthed(pr.port, rd, wr);
        pr.sidA #= HostTest.openOn(ws, 70L);
        pr.sidB #= HostTest.openOn(ws, 80L);
        ws.send("{\"op\":\"generate\",\"id\":1,\"session\":\"" + pr.sidA
            + "\",\"prompt\":\"" + ConcurrencyTest.PROMPT_A + "\",\"n\":6,\"temp\":0}");
        ws.send("{\"op\":\"generate\",\"id\":2,\"session\":\"" + pr.sidB
            + "\",\"prompt\":\"" + ConcurrencyTest.PROMPT_B + "\",\"n\":6,\"temp\":0}");
        while (pr.finA.byteLength() == 0 || pr.finB.byteLength() == 0) {
            String line #= HostTest.recvText(ws);
            if (line == null) {
                break;
            }
            JsonValue v #= Json.parse(line);
            JsonObject o = v.object();
            int64 id = o.containsKey("id") ? o.get("id").asInt64() : (0L - 1L);
            if (o.containsKey("chunk")) {
                String t #= o.get("chunk").asString();
                if (id == 1L) {
                    pr.accA = pr.accA + t;
                } else if (id == 2L) {
                    pr.accB = pr.accB + t;
                }
            } else if (o.containsKey("done") || o.containsKey("error")) {
                String f = o.containsKey("done") ? "done" : "error";
                if (id == 1L) {
                    pr.finA #= "" + f;
                } else if (id == 2L) {
                    pr.finB #= "" + f;
                }
            }
        }
        ws.send("{\"op\":\"shutdown\"}");
        Fiber.sleep(Duration.ofMillis(200L));
        sock.close();
        return 0;
    }

    /** 12.1.3 — two concurrent turns on one connection, each in its own
     *  session, emit only their own chunks, byte-equal to their solos. */
    @Test
    public void twoTurnsOnOneConnectionKeepTheirOwnChunks() {
        String soloA #= ConcurrencyTest.serialRun("tmp/ht-pair-a.jsonl",
            1L, ConcurrencyTest.PROMPT_A);
        String soloB #= ConcurrencyTest.serialRun("tmp/ht-pair-b.jsonl",
            2L, ConcurrencyTest.PROMPT_B);
        LlmEngine e #= ConcurrencyTest.engine(2);
        Host h = heap Host(#e, HostTest.TOKEN, 4, 2, 60000L);
        h.listen(0);
        PairRun pr = heap PairRun();
        pr.port = h.port;
        scope {
            spawn runPair(pr);
            h.run();
            h.shutdown();
        }
        Assert.isFalse(pr.sidA.equals(pr.sidB));
        Assert.equals("done", pr.finA);
        Assert.equals("done", pr.finB);
        Assert.equals(soloA, pr.accA);
        Assert.equals(soloB, pr.accB);
    }

    /** Evidence for 12.1.2: each turn's outcome at its clock time. */
    static class ClockRun {
        public int32 port;
        public ManualTimeSource clock;      // borrow; the test owns it
        public String at0;
        public String at45;
        public String at90;
        public String at151;
        public ClockRun() {
            this.port = 0;
            this.clock = null;
            this.at0 = "";
            this.at45 = "";
            this.at90 = "";
            this.at151 = "";
        }
    }

    /** One 1-token generate in `session`: its finish, or the error kind,
     *  or "cut" when the connection ends first. */
    static #String turnIn(WebSocket ws, String session, int64 id) {
        ws.send("{\"op\":\"generate\",\"id\":" + id + ",\"session\":\"" + session
            + "\",\"prompt\":\"" + ConcurrencyTest.PROMPT_A + "\",\"n\":1,\"temp\":0}");
        while (true) {
            String line #= HostTest.recvText(ws);
            if (line == null) {
                return "cut";
            }
            JsonValue v #= Json.parse(line);
            JsonObject o = v.object();
            if (o.containsKey("error")) {
                String k #= o.get("kind").asString();
                return #k;
            }
            if (o.containsKey("done")) {
                String f #= o.get("finish").asString();
                return #f;
            }
        }
    }

    /** 12.1.2: turns at 0, 45, 90 and 151 s on the installed clock, with a
     *  60 s idle bound. The turn at 90 s is open only if the one at 45 s
     *  refreshed the session; at 151 s it has been idle 61 s. */
    static async int32 runClocked(ClockRun cr) {
        IpAddress a #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#a, cr.port);
        TcpStream sock #= TcpStream.connectAsync(#addr);
        AsyncReader rd = heap AsyncReader(sock);
        AsyncWriter wr = heap AsyncWriter(sock);
        WebSocket ws #= HostTest.dialAuthed(cr.port, rd, wr);
        ws.send("{\"op\":\"open\",\"id\":60}");
        String op #= HostTest.recvText(ws);
        JsonValue ov #= Json.parse(op);
        String sid #= "" + ov.object().get("session").asString();
        cr.at0 #= HostTest.turnIn(ws, sid, 61L);
        cr.clock.advance(45000L);
        cr.at45 #= HostTest.turnIn(ws, sid, 62L);
        cr.clock.advance(45000L);
        cr.at90 #= HostTest.turnIn(ws, sid, 63L);
        cr.clock.advance(61000L);
        cr.at151 #= HostTest.turnIn(ws, sid, 64L);
        ws.send("{\"op\":\"shutdown\"}");
        Fiber.sleep(Duration.ofMillis(200L));
        sock.close();
        return 0;
    }

    /** 12.1.2 — session expiry follows primavera's clock: a turn before the
     *  idle bound keeps the session, and one past it is session_gone. */
    @Test
    public void idleExpiryFollowsTheInstalledClock() {
        LlmEngine e #= ConcurrencyTest.engine(1);
        Host h = heap Host(#e, HostTest.TOKEN, 4, 1, 60000L);
        ManualTimeSource clock = heap ManualTimeSource(1000000L);
        h.useClock(clock);
        h.listen(0);
        ClockRun cr = heap ClockRun();
        cr.port = h.port;
        cr.clock #= clock;
        scope {
            spawn runClocked(cr);
            h.run();
            h.shutdown();
        }
        Assert.equals("budget", cr.at0);
        Assert.equals("budget", cr.at45);
        Assert.equals("budget", cr.at90);
        Assert.equals(ErrKind.SESSION_GONE, cr.at151);
    }

    /** 12.1.5 — past the byte bound the connection closes with 1008 and
     *  its session stays OPEN: a reconnect resumes it by id. The bound
     *  (100 bytes) admits the auth, open and chunk lines and refuses the
     *  done line with its usage block, so the cut is deterministic. The
     *  second connection closes the session by id, which only an open
     *  session answers. */
    @Test
    public void pastTheByteBoundTheConnectionClosesAndItsSessionResumes() {
        LlmEngine e #= ConcurrencyTest.engine(1);
        Host h = heap Host(#e, HostTest.TOKEN, 4, 1, 60000L);
        h.setQueueBytes(100);
        h.listen(0);
        BoundRun br = heap BoundRun();
        br.port = h.port;
        scope {
            spawn runOverBound(br, h);
            h.run();
            h.shutdown();
        }
        Assert.isTrue(br.session != null);
        Assert.isTrue(br.firstCut);
        Assert.equals(1008L, (int64) br.code1);
        Assert.equals("closed", br.finish2);
        Assert.equals(0L, (int64) h.openSessions());
    }
}
