package dev.cajeta.cabra.selftest;

import cajeta.lang.String;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Test;
import dev.cajeta.cabra.LoggingDiagSink;
import dev.cajeta.llm.Diag;
import dev.cajeta.logging.CapturingAppender;
import dev.cajeta.logging.Level;
import dev.cajeta.logging.Log;
import dev.cajeta.logging.Logger;

/**
 * The engine declares the `DiagSink` seam and stays out of the logging
 * business; cabra is the embedder that picks a backend (plan boundary
 * revision, 2026-08-27). This is that bridge.
 *
 * DEBUG is the level on purpose: these lines are "which route did the
 * engine take", which is tuning detail, not operator news. Emitting them
 * at INFO would put them in every default-configured operator's log and
 * recreate exactly the console noise the `Diag` hook exists to prevent.
 * `routeLinesAreBelowInfo` is the arm that catches that regression — it
 * is the one that fails silently otherwise, since a level that is too
 * LOUD still delivers every line the happy-path test asserts.
 */
public class LoggingDiagSinkTest {

    public LoggingDiagSinkTest() { return; }

    /** A line handed to the sink reaches the logger. */
    @Test
    public void engineLinesReachTheLogger() {
        CapturingAppender cap #= heap CapturingAppender();
        Logger log #= Log.capturing("cabra.engine", Level.DEBUG, #cap);
        LoggingDiagSink s #= heap LoggingDiagSink(#log);

        s.line("batch-route: q4k out=1 in=2");

        Assert.equals(1L, (int64) cap.count());
        Assert.isTrue(cap.get(0).contains("batch-route: q4k out=1 in=2"));
    }

    /** Installed through `Diag`, the engine's own calls arrive. */
    @Test
    public void diagSayReachesTheLoggerOnceInstalled() {
        CapturingAppender cap #= heap CapturingAppender();
        Logger log #= Log.capturing("cabra.engine", Level.DEBUG, #cap);
        LoggingDiagSink s #= heap LoggingDiagSink(#log);

        Diag.setSink(s);
        Diag.say("prefill-route: batched");
        Diag.setSink(null);

        Assert.equals(1L, (int64) cap.count());
        Assert.isTrue(cap.get(0).contains("prefill-route: batched"));
    }

    /**
     * The lines are DEBUG, so a logger thresholded at INFO drops them.
     * If the bridge ever logs at info/warn, this goes red — and without
     * it, "too loud" is invisible to every other test here.
     */
    @Test
    public void routeLinesAreBelowInfo() {
        CapturingAppender cap #= heap CapturingAppender();
        Logger log #= Log.capturing("cabra.engine", Level.INFO, #cap);
        LoggingDiagSink s #= heap LoggingDiagSink(#log);

        s.line("batch-route: must not reach an INFO logger");

        Assert.equals(0L, (int64) cap.count());
    }

    /** Nothing installed means nothing logged — the engine's default. */
    @Test
    public void nothingIsLoggedWithNoSinkInstalled() {
        CapturingAppender cap #= heap CapturingAppender();
        Logger log #= Log.capturing("cabra.engine", Level.DEBUG, #cap);

        Diag.setSink(null);
        Diag.say("this line must go nowhere");

        Assert.equals(0L, (int64) cap.count());
    }
}
